Функция ПолучитьСальдоНовогоСценария(
	Счет,
	Организация,
	Аналитика,
	Момент,
	ИсключаемыйРегистратор)

	Если НЕ ЗначениеЗаполнено(Организация)
		ИЛИ НЕ ЗначениеЗаполнено(Аналитика)
		ИЛИ НЕ ЗначениеЗаполнено(Момент) Тогда

		Возврат 0;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(
		|		ВЫБОР
		|			КОГДА Движения.СчетДт = &Счет
		|				И Движения.СубконтоДт1 = &Организация
		|				И Движения.СубконтоДт2 = &Аналитика
		|			ТОГДА Движения.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ), 0)
		|	-
		|	ЕСТЬNULL(СУММА(
		|		ВЫБОР
		|			КОГДА Движения.СчетКт = &Счет
		|				И Движения.СубконтоКт1 = &Организация
		|				И Движения.СубконтоКт2 = &Аналитика
		|			ТОГДА Движения.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ), 0) КАК Сальдо
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто
		|		КАК Движения
		|ГДЕ
		|	Движения.Активность = ИСТИНА
		|	И Движения.Период <= &Момент
		|	И (Движения.СчетДт = &Счет
		|		ИЛИ Движения.СчетКт = &Счет)";

	Если ЗначениеЗаполнено(ИсключаемыйРегистратор) Тогда

		Запрос.Текст = Запрос.Текст
			+ Символы.ПС
			+ "И Движения.Регистратор <> &Регистратор";

		Запрос.УстановитьПараметр(
			"Регистратор", ИсключаемыйРегистратор);

	КонецЕсли;

	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Аналитика", Аналитика);
	Запрос.УстановитьПараметр("Момент", Момент);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сальдо;
	КонецЕсли;

	Возврат 0;

КонецФункции


Функция ЕстьПоздниеДвиженияПоОплатеТруда(
	Организация,
	Сотрудник,
	Момент,
	ИсключаемыйРегистратор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Движения.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто
		|		КАК Движения
		|ГДЕ
		|	Движения.Активность = ИСТИНА
		|	И Движения.Период > &Момент
		|	И Движения.Регистратор <> &Регистратор
		|	И (
		|		(Движения.СчетДт = &Счет
		|			И Движения.СубконтоДт1 = &Организация
		|			И Движения.СубконтоДт2 = &Сотрудник)
		|		ИЛИ
		|		(Движения.СчетКт = &Счет
		|			И Движения.СубконтоКт1 = &Организация
		|			И Движения.СубконтоКт2 = &Сотрудник)
		|	)";

	Запрос.УстановитьПараметр(
		"Счет",
		ПланыСчетов.Хозрасчетный.РасчетыПоОплатеТруда);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр(
		"Регистратор", ИсключаемыйРегистратор);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции