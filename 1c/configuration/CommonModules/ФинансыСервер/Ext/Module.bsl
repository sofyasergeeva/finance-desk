Функция ПолучитьДолгПоОплатеТруда(
	Организация,
	Сотрудник,
	Момент,
	ИсключаемыйРегистратор = Неопределено) Экспорт

	Сальдо = ПолучитьСальдоНовогоСценария(
		ПланыСчетов.Хозрасчетный.РасчетыПоОплатеТруда,
		Организация,
		Сотрудник,
		Момент,
		ИсключаемыйРегистратор);

	Возврат Макс(0, -Сальдо);

