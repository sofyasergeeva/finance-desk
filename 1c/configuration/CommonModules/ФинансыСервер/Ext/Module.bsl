Функция ПолучитьДолгКлиента(
	Организация,
	Контрагент,
	Договор,
	Момент,
	ИсключаемыйРегистратор = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Организация)
		ИЛИ НЕ ЗначениеЗаполнено(Контрагент)
		ИЛИ НЕ ЗначениеЗаполнено(Договор) Тогда

		Возврат 0;

	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(
	|		СУММА(
	|			ВЫБОР
	|				КОГДА Движения.СчетДт = &Счет
	|					И Движения.СубконтоДт1 = &Организация
	|					И Движения.СубконтоДт2 = &Контрагент
	|					И Движения.СубконтоДт3 = &Договор
	|				ТОГДА Движения.Сумма
	|				ИНАЧЕ 0
	|			КОНЕЦ),
	|		0)
	|	-
	|	ЕСТЬNULL(
	|		СУММА(
	|			ВЫБОР
	|				КОГДА Движения.СчетКт = &Счет
	|					И Движения.СубконтоКт1 = &Организация
	|					И Движения.СубконтоКт2 = &Контрагент
	|					И Движения.СубконтоКт3 = &Договор
	|				ТОГДА Движения.Сумма
	|				ИНАЧЕ 0
	|			КОНЕЦ),
	|		0) КАК Долг
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Движения
	|ГДЕ
	|	Движения.Период <= &Момент
	|	И (
	|		Движения.СчетДт = &Счет
	|		ИЛИ Движения.СчетКт = &Счет
	|	)";

	Если ЗначениеЗаполнено(ИсключаемыйРегистратор) Тогда

		Запрос.Текст = Запрос.Текст
			+ Символы.ПС
			+ "И Движения.Регистратор <> &ИсключаемыйРегистратор";

		Запрос.УстановитьПараметр(
			"ИсключаемыйРегистратор",
			ИсключаемыйРегистратор);

	КонецЕсли;

	Запрос.УстановитьПараметр(
		"Счет",
		ПланыСчетов.Хозрасчетный.РасчетыСПокупателями);

	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Момент", Момент);

	Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() Тогда
		Возврат 0;
	КонецЕсли;

	Долг = Выборка.Долг;

	Если Долг < 0 Тогда
		Долг = 0;
	КонецЕсли;

	Возврат Долг;

КонецФункции


