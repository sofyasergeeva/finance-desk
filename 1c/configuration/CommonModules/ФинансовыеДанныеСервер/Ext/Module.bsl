Функция ПолучитьЗадолженностьПокупателей() Экспорт

    Запрос = Новый Запрос;

    Запрос.Текст =
    "ВЫБРАТЬ
    |   ВЫРАЗИТЬ(
    |       ХозрасчетныйОстаткиИОбороты.Субконто1
    |       КАК Справочник.Организации
    |   ) КАК Организация,
    |
    |   ВЫРАЗИТЬ(
    |       ХозрасчетныйОстаткиИОбороты.Субконто2
    |       КАК Справочник.Контрагенты
    |   ) КАК Контрагент,
    |
    |   ВЫРАЗИТЬ(
    |       ХозрасчетныйОстаткиИОбороты.Субконто3
    |       КАК Справочник.Договоры
    |   ) КАК Договор,
    |
    |   ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СуммаДолга
    |
    |ИЗ
    |   РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
    |       НАЧАЛОПЕРИОДА(&НачалоПериода, ДЕНЬ),
    |       КОНЕЦПЕРИОДА(&КонецПериода, ДЕНЬ)
    |   ) КАК ХозрасчетныйОстаткиИОбороты
    |
    |ГДЕ
    |   ХозрасчетныйОстаткиИОбороты.Счет =
    |       ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПокупателями)
    |
    |   И ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокДт > 0";

    ТекущаяДатаСервера = ТекущаяДата();

    Запрос.УстановитьПараметр(
        "НачалоПериода",
        НачалоДня(ТекущаяДатаСервера)
    );

    Запрос.УстановитьПараметр(
        "КонецПериода",
        КонецДня(ТекущаяДатаСервера)
    );

    Результат = Запрос.Выполнить();

    Возврат Результат.Выгрузить();

КонецФункции

// Серверные итоги ОСВ.
// Существующие функции сохранить. Не установлен и не проверен в Конфигураторе.

Функция ПолучитьОСВДляAPI(КодСчета, ДатаС, ДатаПо, Организация = Неопределено) Экспорт

	КодСчета = СокрЛП(КодСчета);
	Если ПустаяСтрока(КодСчета) ИЛИ СтрДлина(КодСчета) > 9 Тогда
		ВызватьИсключение "API_PARAMETER: Некорректный код счёта.";
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(КодСчета) Цикл
		Если СтрНайти("0123456789.", Сред(КодСчета, Позиция, 1)) = 0 Тогда
			ВызватьИсключение "API_PARAMETER: Недопустимый символ кода счёта.";
		КонецЕсли;
	КонецЦикла;
	Если Лев(КодСчета, 1) = "." ИЛИ Прав(КодСчета, 1) = "."
		ИЛИ СтрНайти(КодСчета, "..") > 0 Тогда
		ВызватьИсключение "API_PARAMETER: Некорректный код счёта.";
	КонецЕсли;
	Если ДатаС > ДатаПо Тогда
		ВызватьИсключение "API_PARAMETER: Начало периода позже окончания.";
	КонецЕсли;

	ЗапросСчетов = Новый Запрос;
	ЗапросСчетов.Текст =
		"ВЫБРАТЬ Счета.Ссылка КАК Ссылка
		|ИЗ ПланСчетов.Хозрасчетный КАК Счета
		|ГДЕ Счета.Код ПОДОБНО &Шаблон
		| И НЕ Счета.ПометкаУдаления";
	ЗапросСчетов.УстановитьПараметр("Шаблон", КодСчета + "%");
	ВыборкаСчетов = ЗапросСчетов.Выполнить().Выбрать();
	Счета = Новый Массив;
	ЕстьОрганизация = ЗначениеЗаполнено(Организация);
	Пока ВыборкаСчетов.Следующий() Цикл
		Если ЕстьОрганизация Тогда
			ОбъектСчета = ВыборкаСчетов.Ссылка.ПолучитьОбъект();
			Если ОбъектСчета.ВидыСубконто.Количество() = 0 Тогда
				ВызватьИсключение "API_PARAMETER: У счёта нет аналитики организации.";
			КонецЕсли;
			Если ОбъектСчета.ВидыСубконто[0].ВидСубконто <>
				ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации Тогда
				ВызватьИсключение "API_PARAMETER: Организация должна быть первым субконто.";
			КонецЕсли;
		КонецЕсли;
		Счета.Добавить(ВыборкаСчетов.Ссылка);
	КонецЦикла;
	Если Счета.Количество() = 0 Тогда
		ВызватьИсключение "API_PARAMETER: Счёт или префикс не найден.";
	КонецЕсли;

	// Материализуем все три субконто до суммирования: не сворачиваем сальдо.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		| О.Счет КАК Счет,
		| О.Субконто1 КАК Субконто1,
		| О.Субконто2 КАК Субконто2,
		| О.Субконто3 КАК Субконто3,
		| О.СуммаНачальныйОстатокДт КАК openingDebit,
		| О.СуммаНачальныйОстатокКт КАК openingCredit,
		| О.СуммаОборотДт КАК debitTurnover,
		| О.СуммаОборотКт КАК creditTurnover,
		| О.СуммаКонечныйОстатокДт КАК closingDebit,
		| О.СуммаКонечныйОстатокКт КАК closingCredit
		|ПОМЕСТИТЬ ВТОстатки
		|ИЗ РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		| &Начало, &Конец) КАК О
		|ГДЕ О.Счет В (&Счета)
		| И (&ВсеОрганизации ИЛИ О.Субконто1 = &Организация)
		|;
		|ВЫБРАТЬ
		| О.Счет КАК Счет,
		| СУММА(О.openingDebit) КАК openingDebit,
		| СУММА(О.openingCredit) КАК openingCredit,
		| СУММА(О.debitTurnover) КАК debitTurnover,
		| СУММА(О.creditTurnover) КАК creditTurnover,
		| СУММА(О.closingDebit) КАК closingDebit,
		| СУММА(О.closingCredit) КАК closingCredit,
		| КОЛИЧЕСТВО(*) КАК СтрокАналитики
		|ИЗ ВТОстатки КАК О
		|СГРУППИРОВАТЬ ПО О.Счет
		|УПОРЯДОЧИТЬ ПО О.Счет.Код";
	Запрос.УстановитьПараметр("Начало", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("Конец",
		Новый Граница(КонецДня(ДатаПо), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.УстановитьПараметр("ВсеОрганизации", НЕ ЕстьОрганизация);
	Если ЕстьОрганизация Тогда
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		Запрос.УстановитьПараметр("Организация", Справочники.Организации.ПустаяСсылка());
	КонецЕсли;

	Результат = НовыеИтогиОСВAPI();
	Результат.Вставить("account", КодСчета);
	Результат.Вставить("accounts", Новый Массив);
	Результат.Вставить("rowsScanned", 0);
	Результат.Вставить("source", "1C");
	Результат.Вставить("contractVersion", 1);
	ИменаСумм = СтрРазделить(
		"openingDebit,openingCredit,debitTurnover,creditTurnover,closingDebit,closingCredit", ",");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаСчета = НовыеИтогиОСВAPI();
		СтрокаСчета.Вставить("code", Выборка.Счет.Код);
		СтрокаСчета.Вставить("description", Выборка.Счет.Наименование);
		СтрокаСчета.Вставить("ref", Строка(Выборка.Счет.УникальныйИдентификатор()));
		Для Каждого ИмяСуммы Из ИменаСумм Цикл
			СтрокаСчета[ИмяСуммы] = Выборка[ИмяСуммы];
			Результат[ИмяСуммы] = Результат[ИмяСуммы] + Выборка[ИмяСуммы];
		КонецЦикла;
		Результат.accounts.Добавить(СтрокаСчета);
		Результат.rowsScanned = Результат.rowsScanned + Выборка.СтрокАналитики;
	КонецЦикла;
	Результат.Вставить("openingNet", Результат.openingDebit - Результат.openingCredit);
	Результат.Вставить("closingNet", Результат.closingDebit - Результат.closingCredit);
	Результат.Вставить("consistent", Результат.openingNet
		+ Результат.debitTurnover - Результат.creditTurnover = Результат.closingNet);
	Возврат Результат;

КонецФункции

Функция НовыеИтогиОСВAPI()
	Возврат Новый Структура(
		"openingDebit,openingCredit,debitTurnover,creditTurnover,closingDebit,closingCredit",
		0, 0, 0, 0, 0, 0);
КонецФункции

// Серверные итоги проводок.
// Полный набор строк и итоги строятся из одного результата запроса.

Функция ПолучитьПроводкиДляAPI(ИмяДокументаOData, Идентификатор) Экспорт
	Если Лев(ИмяДокументаOData, 9) <> "Document_" Тогда
		ВызватьИсключение "API_PARAMETER: Ожидается имя Document_*.";
	КонецЕсли;
	ИмяДокумента = Сред(ИмяДокументаOData, 10);
	МетаДокумента = Метаданные.Документы.Найти(ИмяДокумента);
	Если МетаДокумента = Неопределено Тогда
		ВызватьИсключение "API_PARAMETER: Неизвестный вид документа.";
	КонецЕсли;
	Документ = Документы[МетаДокумента.Имя].ПолучитьСсылку(Идентификатор);
	// Имя таблицы берётся из метаданных, не из непроверенной строки запроса.
	Проверка = Новый Запрос;
	Проверка.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка
		|ИЗ Документ." + МетаДокумента.Имя + " КАК Д
		|ГДЕ Д.Ссылка = &Документ";
	Проверка.УстановитьПараметр("Документ", Документ);
	Если Проверка.Выполнить().Пустой() Тогда
		ВызватьИсключение "API_NOT_FOUND: Документ не найден.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50001
		| Д.Период КАК Период, Д.НомерСтроки КАК НомерСтроки,
		| Д.Активность КАК Активность, Д.Сумма КАК Сумма,
		| Д.СчетДт КАК СчетДт, Д.СчетКт КАК СчетКт,
		| Д.СубконтоДт1 КАК СубконтоДт1,
		| Д.СубконтоДт2 КАК СубконтоДт2,
		| Д.СубконтоДт3 КАК СубконтоДт3,
		| Д.СубконтоКт1 КАК СубконтоКт1,
		| Д.СубконтоКт2 КАК СубконтоКт2,
		| Д.СубконтоКт3 КАК СубконтоКт3
		|ИЗ РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Д
		|ГДЕ Д.Регистратор = &Документ
		|УПОРЯДОЧИТЬ ПО Д.НомерСтроки";
	Запрос.УстановитьПараметр("Документ", Документ);
	Строки = Запрос.Выполнить().Выгрузить();
	Если Строки.Количество() > 50000 Тогда
		ВызватьИсключение "API_LIMIT: Превышен предел 50000 проводок. Частичный ответ не сформирован.";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("contractVersion", 1);
	Результат.Вставить("source", "1C");
	Результат.Вставить("document", Новый Структура(
		"entitySet,ref", ИмяДокументаOData, Строка(Идентификатор)));
	Результат.Вставить("rows", Новый Массив);
	Результат.Вставить("postingsCount", Строки.Количество());
	Результат.Вставить("debitTotal", 0);
	Результат.Вставить("creditTotal", 0);
	Результат.Вставить("inactiveCount", 0);
	Результат.Вставить("byCorrespondence", Новый Массив);
	Корреспонденции = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"debitAccount,creditAccount,amount,entries", ",") Цикл
		Корреспонденции.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;

	Для Каждого СтрокаДвижения Из Строки Цикл
		СтрокаОтвета = Новый Структура;
		СтрокаОтвета.Вставить("Period", ДатаПроводкиДляAPI(СтрокаДвижения.Период));
		СтрокаОтвета.Вставить("LineNumber", СтрокаДвижения.НомерСтроки);
		СтрокаОтвета.Вставить("Active", СтрокаДвижения.Активность);
		СтрокаОтвета.Вставить("Сумма", СтрокаДвижения.Сумма);
		СтрокаОтвета.Вставить("AccountDr_Key", СсылкаПроводкиДляAPI(СтрокаДвижения.СчетДт));
		СтрокаОтвета.Вставить("AccountCr_Key", СсылкаПроводкиДляAPI(СтрокаДвижения.СчетКт));
		Для Каждого Сторона Из СтрРазделить("Дт,Кт", ",") Цикл
			Если Сторона = "Дт" Тогда
				Суффикс = "Dr";
			Иначе
				Суффикс = "Cr";
			КонецЕсли;
			Для Индекс = 1 По 3 Цикл
				ЗначениеСубконто = СтрокаДвижения["Субконто" + Сторона + Строка(Индекс)];
				ИмяПоля = "ExtDimension" + Суффикс + Строка(Индекс);
				Если НЕ ЗначениеЗаполнено(ЗначениеСубконто) Тогда
					СтрокаОтвета.Вставить(ИмяПоля, "00000000-0000-0000-0000-000000000000");
					СтрокаОтвета.Вставить(ИмяПоля + "_Type", "");
				Иначе
					МетаЗначения = Метаданные.НайтиПоТипу(ТипЗнч(ЗначениеСубконто));
					Если МетаЗначения = Неопределено Тогда
						ВызватьИсключение "API_SCHEMA: Не поддерживается тип субконто.";
					КонецЕсли;
					Если Лев(МетаЗначения.ПолноеИмя(), 11) <> "Справочник." Тогда
						ВызватьИсключение "API_SCHEMA: Ожидается ссылочное субконто справочника.";
					КонецЕсли;
					СтрокаОтвета.Вставить(ИмяПоля, СсылкаПроводкиДляAPI(ЗначениеСубконто));
					СтрокаОтвета.Вставить(ИмяПоля + "_Type", "Catalog_" + МетаЗначения.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Результат.rows.Добавить(СтрокаОтвета);
		Если НЕ СтрокаДвижения.Активность Тогда
			Результат.inactiveCount = Результат.inactiveCount + 1;
			Продолжить;
		КонецЕсли;
		КодДт = "";
		КодКт = "";
		Если ЗначениеЗаполнено(СтрокаДвижения.СчетДт) Тогда
			КодДт = СтрокаДвижения.СчетДт.Код;
			Результат.debitTotal = Результат.debitTotal + СтрокаДвижения.Сумма;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаДвижения.СчетКт) Тогда
			КодКт = СтрокаДвижения.СчетКт.Код;
			Результат.creditTotal = Результат.creditTotal + СтрокаДвижения.Сумма;
		КонецЕсли;
		Найденные = Корреспонденции.НайтиСтроки(
			Новый Структура("debitAccount,creditAccount", КодДт, КодКт));
		Если Найденные.Количество() = 0 Тогда
			Группа = Корреспонденции.Добавить();
			Группа.debitAccount = КодДт;
			Группа.creditAccount = КодКт;
			Группа.amount = 0;
			Группа.entries = 0;
		Иначе
			Группа = Найденные[0];
		КонецЕсли;
		Группа.amount = Группа.amount + СтрокаДвижения.Сумма;
		Группа.entries = Группа.entries + 1;
	КонецЦикла;
	Корреспонденции.Сортировать("amount Убыв, debitAccount, creditAccount");
	Для Каждого Группа Из Корреспонденции Цикл
		КодДт = Группа.debitAccount;
		КодКт = Группа.creditAccount;
		Если КодДт = "" Тогда
			КодДт = Null;
		КонецЕсли;
		Если КодКт = "" Тогда
			КодКт = Null;
		КонецЕсли;
		Результат.byCorrespondence.Добавить(Новый Структура(
			"debitAccount,creditAccount,amount,entries",
			КодДт, КодКт, Группа.amount, Группа.entries));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СсылкаПроводкиДляAPI(Ссылка)
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "00000000-0000-0000-0000-000000000000";
	КонецЕсли;
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

Функция ДатаПроводкиДляAPI(ЗначениеДаты)
	Возврат Формат(ЗначениеДаты, "ДФ=yyyy-MM-dd") + "T"
		+ Формат(ЗначениеДаты, "ДФ=HH:mm:ss");
КонецФункции
