КонецФункции

Функция CustomerDebtsGetCustomerDebts(Запрос)

    Данные = ФинансовыеДанныеСервер.ПолучитьЗадолженностьПокупателей();

    МассивДанных = Новый Массив;

    Для Каждого СтрокаДанных Из Данные Цикл

        Организация = Новый Структура;
        Организация.Вставить(
            "id",
            Строка(СтрокаДанных.Организация.УникальныйИдентификатор())
        );
        Организация.Вставить(
            "name",
            Строка(СтрокаДанных.Организация)
        );

        Контрагент = Новый Структура;
        Контрагент.Вставить(
            "id",
            Строка(СтрокаДанных.Контрагент.УникальныйИдентификатор())
        );
        Контрагент.Вставить(
            "name",
            Строка(СтрокаДанных.Контрагент)
        );

        Объект = Новый Структура;

        Объект.Вставить("organization", Организация);
        Объект.Вставить("counterparty", Контрагент);

        Если ЗначениеЗаполнено(СтрокаДанных.Договор) Тогда

            Договор = Новый Структура;
            Договор.Вставить(
                "id",
                Строка(СтрокаДанных.Договор.УникальныйИдентификатор())
            );
            Договор.Вставить(
                "name",
                Строка(СтрокаДанных.Договор)
            );

            Объект.Вставить("contract", Договор);

        КонецЕсли;

        Объект.Вставить(
            "amount",
            СтрокаДанных.СуммаДолга
        );

        МассивДанных.Добавить(Объект);

    КонецЦикла;

    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();

    ЗаписатьJSON(
        ЗаписьJSON,
        МассивДанных
    );

    ТелоОтвета = ЗаписьJSON.Закрыть();

    Ответ = Новый HTTPСервисОтвет(200);

    Ответ.Заголовки.Вставить(
        "Content-Type",
        "application/json; charset=utf-8"
    );

    Ответ.УстановитьТелоИзСтроки(ТелоОтвета);

    Возврат Ответ;

КонецФункции

// Дополнительные HTTP-обработчики финансовых итогов.
// Сохранить HealthGetHealth и CustomerDebtsGetCustomerDebts.
// Новый маршрут: GET /account-turnover, обработчик ниже.
// Не установлен и не проверен в Конфигураторе.

Функция AccountTurnoverGetAccountTurnover(Запрос)
	Попытка
		КодСчета = Запрос.ПараметрыЗапроса.Получить("account");
		Если КодСчета = Неопределено Тогда
			ВызватьИсключение "API_PARAMETER: Не указан account.";
		КонецЕсли;
		ДатаС = ПрочитатьДатуОСВAPI(Запрос.ПараметрыЗапроса.Получить("from"));
		ДатаПо = ПрочитатьДатуОСВAPI(Запрос.ПараметрыЗапроса.Получить("to"));
		Организация = Неопределено;
		СсылкаОрганизации = Запрос.ПараметрыЗапроса.Получить("organization");
		Если СсылкаОрганизации <> Неопределено Тогда
			Попытка
				Идентификатор = Новый УникальныйИдентификатор(СсылкаОрганизации);
			Исключение
				ВызватьИсключение "API_PARAMETER: Некорректная ссылка организации.";
			КонецПопытки;
			Организация = Справочники.Организации.ПолучитьСсылку(Идентификатор);
			Проверка = Новый Запрос;
			Проверка.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1 О.Ссылка КАК Ссылка
				|ИЗ Справочник.Организации КАК О
				|ГДЕ О.Ссылка = &Организация";
			Проверка.УстановитьПараметр("Организация", Организация);
			Если Проверка.Выполнить().Пустой() Тогда
				ВызватьИсключение "API_PARAMETER: Организация не найдена.";
			КонецЕсли;
		КонецЕсли;
		Данные = ФинансовыеДанныеСервер.ПолучитьОСВДляAPI(
			КодСчета, ДатаС, ДатаПо, Организация);
		Данные.Вставить("period", Новый Структура("from,to",
			Запрос.ПараметрыЗапроса.Получить("from"),
			Запрос.ПараметрыЗапроса.Получить("to")));
		Если ЗначениеЗаполнено(Организация) Тогда
			Данные.Вставить("organization", Строка(Организация));
			Данные.Вставить("organizationRef", СсылкаОрганизации);
		КонецЕсли;
		Возврат ОтветОСВAPI(200, Данные);
	Исключение
		Если СтрНайти(ОписаниеОшибки(), "API_PARAMETER:") > 0 Тогда
			Возврат ОтветОСВAPI(400,
				Новый Структура("error", "Некорректные параметры запроса ОСВ."));
		КонецЕсли;
		Возврат ОтветОСВAPI(500,
			Новый Структура("error", "Ошибка получения ОСВ в 1С."));
	КонецПопытки;
КонецФункции

Функция ПрочитатьДатуОСВAPI(ЗначениеПараметра)
	Если ЗначениеПараметра = Неопределено Тогда
		ВызватьИсключение "API_PARAMETER: Не указан период.";
	КонецЕсли;
	ТекстДаты = ЗначениеПараметра;
	Если СтрДлина(ТекстДаты) <> 10 Тогда
		ВызватьИсключение "API_PARAMETER: Формат даты YYYY-MM-DD.";
	КонецЕсли;
	Если Сред(ТекстДаты, 5, 1) <> "-" ИЛИ Сред(ТекстДаты, 8, 1) <> "-" Тогда
		ВызватьИсключение "API_PARAMETER: Формат даты YYYY-MM-DD.";
	КонецЕсли;
	Цифры = Лев(ТекстДаты, 4) + Сред(ТекстДаты, 6, 2) + Прав(ТекстДаты, 2);
	Для Позиция = 1 По 8 Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
			ВызватьИсключение "API_PARAMETER: Некорректная дата.";
		КонецЕсли;
	КонецЦикла;
	Попытка
		Результат = Дата(Число(Лев(ТекстДаты, 4)),
			Число(Сред(ТекстДаты, 6, 2)), Число(Прав(ТекстДаты, 2)));
	Исключение
		ВызватьИсключение "API_PARAMETER: Несуществующая дата.";
	КонецПопытки;
	// Не допускаем нормализации некорректных календарных компонентов.
	Если Год(Результат) <> Число(Лев(ТекстДаты, 4))
		ИЛИ Месяц(Результат) <> Число(Сред(ТекстДаты, 6, 2))
		ИЛИ День(Результат) <> Число(Прав(ТекстДаты, 2)) Тогда
		ВызватьИсключение "API_PARAMETER: Несуществующая дата.";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ОтветОСВAPI(КодОтвета, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Тело = Запись.Закрыть();
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Тело);
	Возврат Ответ;
КонецФункции

// Обработчик проводок; использует ОтветОСВAPI.
// Шаблон DocumentPostings /document-postings, метод GET.

Функция DocumentPostingsGetDocumentPostings(Запрос)
	Попытка
		ВидДокумента = Запрос.ПараметрыЗапроса.Получить("documentEntity");
		СсылкаДокумента = Запрос.ПараметрыЗапроса.Получить("documentRef");
		Если ВидДокумента = Неопределено ИЛИ СсылкаДокумента = Неопределено Тогда
			ВызватьИсключение "API_PARAMETER: Не указаны вид или ссылка документа.";
		КонецЕсли;
		Попытка
			Идентификатор = Новый УникальныйИдентификатор(СсылкаДокумента);
		Исключение
			ВызватьИсключение "API_PARAMETER: Некорректная ссылка документа.";
		КонецПопытки;
		Данные = ФинансовыеДанныеСервер.ПолучитьПроводкиДляAPI(
			ВидДокумента, Идентификатор);
		Возврат ОтветОСВAPI(200, Данные);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Если СтрНайти(ТекстОшибки, "API_PARAMETER:") > 0 Тогда
			Возврат ОтветОСВAPI(400, Новый Структура("error", "Некорректные параметры проводок."));
		КонецЕсли;
		Если СтрНайти(ТекстОшибки, "API_NOT_FOUND:") > 0 Тогда
			Возврат ОтветОСВAPI(404, Новый Структура("error", "Документ не найден."));
		КонецЕсли;
		Если СтрНайти(ТекстОшибки, "API_LIMIT:") > 0 Тогда
			Возврат ОтветОСВAPI(413, Новый Структура("error", "Превышен предел проводок. Частичный ответ не сформирован."));
		КонецЕсли;
		Возврат ОтветОСВAPI(500, Новый Структура("error", "Ошибка получения проводок в 1С."));
	КонецПопытки;
КонецФункции
