		<query>ВЫБРАТЬ
	ВЫРАЗИТЬ(
		Движения.СубконтоДт1
		КАК Справочник.Организации
	) КАК Организация,

	ВЫРАЗИТЬ(
		Движения.СубконтоДт2
		КАК Справочник.Сотрудники
	) КАК Сотрудник,

	Движения.Сумма КАК Выдано,
	0 КАК Подтверждено,
	0 КАК Возвращено,
	0 КАК Остаток

ИЗ
	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Движения

ГДЕ
	Движения.Активность
	И Движения.Период МЕЖДУ
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ)
		И КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	И Движения.СчетДт =
		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСППодотчетнымиЛицами)


ОБЪЕДИНИТЬ ВСЕ


ВЫБРАТЬ
	ВЫРАЗИТЬ(
		Движения.СубконтоКт1
		КАК Справочник.Организации
	),

	ВЫРАЗИТЬ(
		Движения.СубконтоКт2
		КАК Справочник.Сотрудники
	),

	0,
	Движения.Сумма,
	0,
	0

ИЗ
	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Движения

ГДЕ
	Движения.Активность
	И Движения.Период МЕЖДУ
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ)
		И КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	И Движения.СчетКт =
		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСППодотчетнымиЛицами)
	И Движения.СчетДт =
		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.ОбщехозяйственныеРасходы)


ОБЪЕДИНИТЬ ВСЕ


ВЫБРАТЬ
	ВЫРАЗИТЬ(
		Движения.СубконтоКт1
		КАК Справочник.Организации
	),

	ВЫРАЗИТЬ(
		Движения.СубконтоКт2
		КАК Справочник.Сотрудники
	),

	0,
	0,
	Движения.Сумма,
	0

ИЗ
	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Движения

ГДЕ
	Движения.Активность
	И Движения.Период МЕЖДУ
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ)
		И КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	И Движения.СчетКт =
		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСППодотчетнымиЛицами)
	И Движения.СчетДт В (
		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.Касса),
		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетныеСчета)
	)


ОБЪЕДИНИТЬ ВСЕ


ВЫБРАТЬ
	ВЫРАЗИТЬ(
		Остатки.Субконто1
		КАК Справочник.Организации
	),

	ВЫРАЗИТЬ(
		Остатки.Субконто2
		КАК Справочник.Сотрудники
	),

	0,
	0,
	0,

	Остатки.СуммаКонечныйОстатокДт
		- Остатки.СуммаКонечныйОстатокКт

ИЗ
	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ),
		КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	) КАК Остатки

ГДЕ
	Остатки.Счет =
		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСППодотчетнымиЛицами)</query>
