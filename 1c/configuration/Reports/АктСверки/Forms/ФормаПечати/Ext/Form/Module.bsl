&НаКлиенте
Процедура СформироватьАктСверки(Команда)

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Необходимо выбрать организацию.");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Сообщить("Необходимо выбрать контрагента.");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
		Сообщить("Необходимо указать начало периода.");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(КонецПериода) Тогда
		Сообщить("Необходимо указать конец периода.");
		Возврат;
	КонецЕсли;

	Если НачалоПериода > КонецПериода Тогда
		Сообщить(
			"Начало периода не может быть позже конца периода."
		);
		Возврат;
	КонецЕсли;


	ТабДок =
		ПолучитьПечатнуюФормуНаСервере();

	ТабДок.Показать(
		"Акт сверки"
	);

КонецПроцедуры


&НаСервере
Функция ПолучитьПечатнуюФормуНаСервере()

	Возврат
		Отчеты.АктСверки.СформироватьПечатнуюФорму(
			Организация,
			Контрагент,
			Договор,
			НачалоПериода,
			КонецПериода
		);

КонецФункции