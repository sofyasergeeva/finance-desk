	),

	Движения.Период,
	Движения.Регистратор,

	"Оплата",

	0,
	Движения.Сумма,

	0,
	0

ИЗ
	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Движения

ГДЕ
	Движения.Активность
	И Движения.Период МЕЖДУ
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ)
		И КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	И Движения.СчетДт =
		ЗНАЧЕНИЕ(
			ПланСчетов.Хозрасчетный.РасчетыСПоставщиками
		)


ОБЪЕДИНИТЬ ВСЕ


ВЫБРАТЬ
	ВЫБОР
		КОГДА Остатки.Счет =
			ЗНАЧЕНИЕ(
				ПланСчетов.Хозрасчетный.РасчетыСПокупателями
			)
			ТОГДА "Нам должны"
		ИНАЧЕ "Мы должны"
	КОНЕЦ,

	ВЫРАЗИТЬ(
		Остатки.Субконто1
		КАК Справочник.Организации
	),

	ВЫРАЗИТЬ(
		Остатки.Субконто2
		КАК Справочник.Контрагенты
	),

	ВЫРАЗИТЬ(
		Остатки.Субконто3
		КАК Справочник.Договоры
	),

	НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ),
	NULL,

	"Остатки",

	0,
	0,

	ВЫБОР
		КОГДА Остатки.Счет =
			ЗНАЧЕНИЕ(
				ПланСчетов.Хозрасчетный.РасчетыСПокупателями
			)
			ТОГДА
				Остатки.СуммаНачальныйОстатокДт
				- Остатки.СуммаНачальныйОстатокКт
		ИНАЧЕ
				Остатки.СуммаНачальныйОстатокКт
				- Остатки.СуммаНачальныйОстатокДт
	КОНЕЦ,

	ВЫБОР
		КОГДА Остатки.Счет =
			ЗНАЧЕНИЕ(
				ПланСчетов.Хозрасчетный.РасчетыСПокупателями
			)
			ТОГДА
				Остатки.СуммаКонечныйОстатокДт
				- Остатки.СуммаКонечныйОстатокКт
		ИНАЧЕ
				Остатки.СуммаКонечныйОстатокКт
				- Остатки.СуммаКонечныйОстатокДт
	КОНЕЦ

ИЗ
	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ),
		КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	) КАК Остатки

ГДЕ
	Остатки.Счет В (
		ЗНАЧЕНИЕ(
			ПланСчетов.Хозрасчетный.РасчетыСПокупателями
		),
		ЗНАЧЕНИЕ(
			ПланСчетов.Хозрасчетный.РасчетыСПоставщиками
		)
	)</query>
