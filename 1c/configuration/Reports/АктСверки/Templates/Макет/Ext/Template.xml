		<query>ВЫБРАТЬ
	"Нам должны" КАК ВидВзаиморасчетов,

	ВЫРАЗИТЬ(
		Движения.СубконтоДт1
		КАК Справочник.Организации
	) КАК Организация,

	ВЫРАЗИТЬ(
		Движения.СубконтоДт2
		КАК Справочник.Контрагенты
	) КАК Контрагент,

	ВЫРАЗИТЬ(
		Движения.СубконтоДт3
		КАК Справочник.Договоры
	) КАК Договор,

	Движения.Период КАК Дата,
	Движения.Регистратор КАК Документ,

	"Начисление" КАК Операция,

	Движения.Сумма КАК Начислено,
	0 КАК Оплачено,

	0 КАК НачальныйДолг,
	0 КАК КонечныйДолг

ИЗ
	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Движения

ГДЕ
	Движения.Активность
	И Движения.Период МЕЖДУ
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ)
		И КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	И Движения.СчетДт =
		ЗНАЧЕНИЕ(
			ПланСчетов.Хозрасчетный.РасчетыСПокупателями
		)


ОБЪЕДИНИТЬ ВСЕ


ВЫБРАТЬ
	"Нам должны",

	ВЫРАЗИТЬ(
		Движения.СубконтоКт1
		КАК Справочник.Организации
	),

	ВЫРАЗИТЬ(
		Движения.СубконтоКт2
		КАК Справочник.Контрагенты
	),

	ВЫРАЗИТЬ(
		Движения.СубконтоКт3
		КАК Справочник.Договоры
	),

	Движения.Период,
	Движения.Регистратор,

	"Оплата",

	0,
	Движения.Сумма,

	0,
	0

ИЗ
	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Движения

ГДЕ
	Движения.Активность
	И Движения.Период МЕЖДУ
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ)
		И КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	И Движения.СчетКт =
		ЗНАЧЕНИЕ(
			ПланСчетов.Хозрасчетный.РасчетыСПокупателями
		)


ОБЪЕДИНИТЬ ВСЕ


ВЫБРАТЬ
	"Мы должны",

	ВЫРАЗИТЬ(
		Движения.СубконтоКт1
		КАК Справочник.Организации
	),

	ВЫРАЗИТЬ(
		Движения.СубконтоКт2
		КАК Справочник.Контрагенты
	),

	ВЫРАЗИТЬ(
		Движения.СубконтоКт3
		КАК Справочник.Договоры
	),

	Движения.Период,
	Движения.Регистратор,

	"Начисление",

	Движения.Сумма,
	0,

	0,
	0

ИЗ
	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Движения

ГДЕ
	Движения.Активность
	И Движения.Период МЕЖДУ
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ)
		И КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	И Движения.СчетКт =
		ЗНАЧЕНИЕ(
			ПланСчетов.Хозрасчетный.РасчетыСПоставщиками
		)


ОБЪЕДИНИТЬ ВСЕ


ВЫБРАТЬ
	"Мы должны",

	ВЫРАЗИТЬ(
