Функция СформироватьПечатнуюФорму(
	Организация,
	Контрагент,
	Договор,
	НачалоПериода,
	КонецПериода
) Экспорт

	ТабДок = Новый ТабличныйДокумент;

	Макет = ПолучитьМакет(
		"ПечатнаяФормаАктаСверки"
	);

	НачалоПериодаДня =
		НачалоДня(НачалоПериода);

	КонецПериодаДня =
		КонецДня(КонецПериода);


	// =================================================
	// Получаем движения 60 / 62
	// =================================================

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Период КАК Дата,
	|	Движения.Регистратор КАК Документ,
	|	Движения.СчетДт КАК СчетДт,
	|	Движения.СчетКт КАК СчетКт,
	|	Движения.Сумма КАК Сумма,
	|	Движения.СубконтоДт1 КАК ОрганизацияДт,
	|	Движения.СубконтоДт2 КАК КонтрагентДт,
	|	Движения.СубконтоДт3 КАК ДоговорДт,
	|	Движения.СубконтоКт1 КАК ОрганизацияКт,
	|	Движения.СубконтоКт2 КАК КонтрагентКт,
	|	Движения.СубконтоКт3 КАК ДоговорКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто КАК Движения
	|ГДЕ
	|	Движения.Активность
	|	И Движения.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И (
	|		Движения.СчетДт =
	|			ЗНАЧЕНИЕ(
	|				ПланСчетов.Хозрасчетный.РасчетыСПокупателями
	|			)
	|		ИЛИ Движения.СчетКт =
	|			ЗНАЧЕНИЕ(
	|				ПланСчетов.Хозрасчетный.РасчетыСПокупателями
	|			)
	|		ИЛИ Движения.СчетДт =
	|			ЗНАЧЕНИЕ(
	|				ПланСчетов.Хозрасчетный.РасчетыСПоставщиками
	|			)
	|		ИЛИ Движения.СчетКт =
	|			ЗНАЧЕНИЕ(
	|				ПланСчетов.Хозрасчетный.РасчетыСПоставщиками
	|			)
	|	)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Запрос.УстановитьПараметр(
		"НачалоПериода",
		НачалоПериодаДня
	);

	Запрос.УстановитьПараметр(
		"КонецПериода",
		КонецПериодаДня
	);

	ТаблицаДвижений =
		Запрос.Выполнить().Выгрузить();


	// =================================================
	// Определяем остатки из Хозрасчетный
	// =================================================

	НачальныйДолг = 0;
	КонечныйДолг = 0;

	ЗапросОстатков = Новый Запрос;

	ЗапросОстатков.Текст =
	"ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Субконто1 КАК Организация,
	|	Остатки.Субконто2 КАК Контрагент,
	|	Остатки.Субконто3 КАК Договор,
	|	Остатки.СуммаНачальныйОстатокДт КАК НачДт,
	|	Остатки.СуммаНачальныйОстатокКт КАК НачКт,
	|	Остатки.СуммаКонечныйОстатокДт КАК КонДт,
	|	Остатки.СуммаКонечныйОстатокКт КАК КонКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
	|		&НачалоПериода,
	|		&КонецПериода
	|	) КАК Остатки
	|ГДЕ
	|	Остатки.Счет В (
	|		ЗНАЧЕНИЕ(
	|			ПланСчетов.Хозрасчетный.РасчетыСПокупателями
	|		),
	|		ЗНАЧЕНИЕ(
	|			ПланСчетов.Хозрасчетный.РасчетыСПоставщиками
	|		)
	|	)";

	ЗапросОстатков.УстановитьПараметр(
		"НачалоПериода",
		НачалоПериодаДня
	);

	ЗапросОстатков.УстановитьПараметр(
		"КонецПериода",
		КонецПериодаДня
	);

	ВыборкаОстатков =
		ЗапросОстатков.Выполнить().Выбрать();

	Пока ВыборкаОстатков.Следующий() Цикл

		Если
			ВыборкаОстатков.Организация <> Организация
			ИЛИ ВыборкаОстатков.Контрагент <> Контрагент
		Тогда

			Продолжить;

		КонецЕсли;

		Если ЗначениеЗаполнено(Договор)
			И ВыборкаОстатков.Договор <> Договор Тогда

			Продолжить;

		КонецЕсли;


		Если ВыборкаОстатков.Счет =
			ПланыСчетов.Хозрасчетный.РасчетыСПокупателями Тогда

			НачальныйДолг =
				НачальныйДолг
				+ ВыборкаОстатков.НачДт
				- ВыборкаОстатков.НачКт;

			КонечныйДолг =
				КонечныйДолг
				+ ВыборкаОстатков.КонДт
				- ВыборкаОстатков.КонКт;

		Иначе

			НачальныйДолг =
				НачальныйДолг
				+ ВыборкаОстатков.НачКт
				- ВыборкаОстатков.НачДт;

			КонечныйДолг =
				КонечныйДолг
				+ ВыборкаОстатков.КонКт
				- ВыборкаОстатков.КонДт;

		КонецЕсли;

	КонецЦикла;


	// =================================================
	// Заголовок
	// =================================================

	Область = Макет.ПолучитьОбласть("Заголовок");

	Область.Область("R3C1").Текст =
		"с "
		+ Формат(
			НачалоПериода,
			"ДФ='dd.MM.yyyy'"
		)
		+ " по "
		+ Формат(
			КонецПериода,
			"ДФ='dd.MM.yyyy'"
		);

	ТабДок.Вывести(Область);


	// =================================================
	// Стороны
	// =================================================

	Область = Макет.ПолучитьОбласть("Стороны");

	Область.Область("R1C2").Текст =
		Строка(Организация);

	Если ЗначениеЗаполнено(Контрагент.ПолноеНаименование) Тогда

		Область.Область("R2C2").Текст =
			Контрагент.ПолноеНаименование;

	Иначе

		Область.Область("R2C2").Текст =
			Строка(Контрагент);

	КонецЕсли;

	Если ЗначениеЗаполнено(Договор) Тогда

		Область.Область("R3C2").Текст =
			Строка(Договор);

	Иначе

		Область.Область("R3C2").Текст =
			"Все договоры";

	КонецЕсли;

	ТабДок.Вывести(Область);


	// =================================================
	// Начальный остаток
	// =================================================

	Область =
		Макет.ПолучитьОбласть("НачальныйОстаток");

	Область.Область("R1C2").Текст =
		Формат(
			НачальныйДолг,
			"ЧДЦ=2; ЧРГ=' '"
		);

	ТабДок.Вывести(Область);


	// =================================================
	// Таблица
	// =================================================

	Область =
		Макет.ПолучитьОбласть("ШапкаТаблицы");

	ТабДок.Вывести(Область);


	ИтогоНачислено = 0;
	ИтогоОплачено = 0;
	НомерСтроки = 0;


	Для Каждого СтрокаДвижения Из ТаблицаДвижений Цикл

		Начислено = 0;
		Оплачено = 0;
		Подходит = Ложь;


		// ---------------------------------------------
		// 62 — Нам должны
		// ---------------------------------------------

		Если СтрокаДвижения.СчетДт =
			ПланыСчетов.Хозрасчетный.РасчетыСПокупателями Тогда

			Если
				СтрокаДвижения.ОрганизацияДт = Организация
				И СтрокаДвижения.КонтрагентДт = Контрагент
			Тогда

				Если НЕ ЗначениеЗаполнено(Договор)
					ИЛИ СтрокаДвижения.ДоговорДт = Договор Тогда

					Начислено = СтрокаДвижения.Сумма;
					Подходит = Истина;

				КонецЕсли;

			КонецЕсли;

		ИначеЕсли СтрокаДвижения.СчетКт =
			ПланыСчетов.Хозрасчетный.РасчетыСПокупателями Тогда

			Если
				СтрокаДвижения.ОрганизацияКт = Организация
				И СтрокаДвижения.КонтрагентКт = Контрагент
			Тогда

				Если НЕ ЗначениеЗаполнено(Договор)
					ИЛИ СтрокаДвижения.ДоговорКт = Договор Тогда

					Оплачено = СтрокаДвижения.Сумма;
					Подходит = Истина;

				КонецЕсли;

			КонецЕсли;


		// ---------------------------------------------
		// 60 — Мы должны
		// ---------------------------------------------

		ИначеЕсли СтрокаДвижения.СчетКт =
			ПланыСчетов.Хозрасчетный.РасчетыСПоставщиками Тогда

			Если
				СтрокаДвижения.ОрганизацияКт = Организация
				И СтрокаДвижения.КонтрагентКт = Контрагент
			Тогда

				Если НЕ ЗначениеЗаполнено(Договор)
					ИЛИ СтрокаДвижения.ДоговорКт = Договор Тогда

					Начислено = СтрокаДвижения.Сумма;
					Подходит = Истина;

				КонецЕсли;

			КонецЕсли;

		ИначеЕсли СтрокаДвижения.СчетДт =
			ПланыСчетов.Хозрасчетный.РасчетыСПоставщиками Тогда

			Если
				СтрокаДвижения.ОрганизацияДт = Организация
				И СтрокаДвижения.КонтрагентДт = Контрагент
			Тогда

				Если НЕ ЗначениеЗаполнено(Договор)
					ИЛИ СтрокаДвижения.ДоговорДт = Договор Тогда

					Оплачено = СтрокаДвижения.Сумма;
					Подходит = Истина;

				КонецЕсли;

			КонецЕсли;

		КонецЕсли;


		Если НЕ Подходит Тогда
			Продолжить;
		КонецЕсли;


		НомерСтроки = НомерСтроки + 1;

		Область = Макет.ПолучитьОбласть("Строка");

		Область.Область("R1C1").Текст =
			Строка(НомерСтроки);

		Область.Область("R1C2").Текст =
			Формат(
				СтрокаДвижения.Дата,
				"ДФ='dd.MM.yyyy'"
			);

		Область.Область("R1C3").Текст =
			Строка(СтрокаДвижения.Документ);

		Если Начислено > 0 Тогда

			Область.Область("R1C4").Текст =
				"Начисление";

		Иначе

			Область.Область("R1C4").Текст =
				"Оплата";

		КонецЕсли;

		Если Начислено > 0 Тогда

			Область.Область("R1C5").Текст =
				Формат(
					Начислено,
					"ЧДЦ=2; ЧРГ=' '"
				);

		Иначе

			Область.Область("R1C5").Текст = "";

		КонецЕсли;

		Если Оплачено > 0 Тогда

			Область.Область("R1C6").Текст =
				Формат(
					Оплачено,
					"ЧДЦ=2; ЧРГ=' '"
				);

		Иначе

			Область.Область("R1C6").Текст = "";

		КонецЕсли;

		ТабДок.Вывести(Область);

		ИтогоНачислено =
			ИтогоНачислено + Начислено;

		ИтогоОплачено =
			ИтогоОплачено + Оплачено;

	КонецЦикла;


	// =================================================
	// Итоги
	// =================================================

	Область = Макет.ПолучитьОбласть("Итоги");

	Область.Область("R1C6").Текст =
		Формат(
			ИтогоНачислено,
			"ЧДЦ=2; ЧРГ=' '"
		);

	Область.Область("R2C6").Текст =
		Формат(
			ИтогоОплачено,
			"ЧДЦ=2; ЧРГ=' '"
		);

	Область.Область("R3C6").Текст =
		Формат(
			КонечныйДолг,
			"ЧДЦ=2; ЧРГ=' '"
		);

	ТабДок.Вывести(Область);


	// =================================================
	// Подписи
	// =================================================

	Область = Макет.ПолучитьОбласть("Подписи");

	Область.Область("R5C2").Текст =
		Строка(Организация);

	Если ЗначениеЗаполнено(Контрагент.ПолноеНаименование) Тогда

		Область.Область("R5C6").Текст =
			Контрагент.ПолноеНаименование;

	Иначе

		Область.Область("R5C6").Текст =
			Строка(Контрагент);

	КонецЕсли;

	ТабДок.Вывести(Область);


	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы =
		ОриентацияСтраницы.Портрет;

	Возврат ТабДок;

КонецФункции