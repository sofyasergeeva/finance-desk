		<query>ВЫБРАТЬ
	ХозрасчетныйОстаткиИОбороты.Счет КАК Счет,

	ВЫРАЗИТЬ(
		ХозрасчетныйОстаткиИОбороты.Субконто1
		КАК Справочник.Организации
	) КАК Организация,

	ВЫРАЗИТЬ(
		ХозрасчетныйОстаткиИОбороты.Субконто2
		КАК Справочник.Контрагенты
	) КАК Контрагент,

	ВЫРАЗИТЬ(
		ХозрасчетныйОстаткиИОбороты.Субконто3
		КАК Справочник.Договоры
	) КАК Договор,

	ВЫБОР
		КОГДА ХозрасчетныйОстаткиИОбороты.Счет =
			ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПокупателями)
			ТОГДА "Нам должны"
		ИНАЧЕ "Мы должны"
	КОНЕЦ КАК ВидВзаиморасчетов,

	ВЫБОР
		КОГДА ХозрасчетныйОстаткиИОбороты.Счет =
			ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПокупателями)
			ТОГДА ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокДт
		ИНАЧЕ ХозрасчетныйОстаткиИОбороты.СуммаНачальныйОстатокКт
	КОНЕЦ КАК НачальныйДолг,

	ВЫБОР
		КОГДА ХозрасчетныйОстаткиИОбороты.Счет =
			ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПокупателями)
			ТОГДА ХозрасчетныйОстаткиИОбороты.СуммаОборотДт
		ИНАЧЕ ХозрасчетныйОстаткиИОбороты.СуммаОборотКт
	КОНЕЦ КАК Начислено,

	ВЫБОР
		КОГДА ХозрасчетныйОстаткиИОбороты.Счет =
			ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПокупателями)
			ТОГДА ХозрасчетныйОстаткиИОбороты.СуммаОборотКт
		ИНАЧЕ ХозрасчетныйОстаткиИОбороты.СуммаОборотДт
	КОНЕЦ КАК Оплачено,

	ВЫБОР
		КОГДА ХозрасчетныйОстаткиИОбороты.Счет =
			ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПокупателями)
			ТОГДА ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокДт
		ИНАЧЕ ХозрасчетныйОстаткиИОбороты.СуммаКонечныйОстатокКт
	КОНЕЦ КАК КонечныйДолг

ИЗ
	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ),
		КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)
	) КАК ХозрасчетныйОстаткиИОбороты

ГДЕ
	ХозрасчетныйОстаткиИОбороты.Счет В (
		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПокупателями),
		ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПоставщиками)
	)</query>
