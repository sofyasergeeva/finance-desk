// Дополнение модуля управляемой формы отчёта ОСВХозрасчетный.
// Реквизит Результат: ТабличныйДокумент, штатный результат отчёта.
// Основной реквизит Отчет и стандартные команды СКД сохраняются.
// Назначить команде СохранитьCSV обработчик СохранитьCSV.
// XML DEMO: режим совместимости 8.3.26, синхронные вызовы расширений запрещены.
// 11.11.2026: файловые операции переведены на штатные асинхронные методы.
// Исправленный вариант требует синтаксического контроля и внешней пробы в 1С.

&НаКлиенте
Процедура СохранитьCSV(Команда)

	Попытка
		// Снимок фиксируется ДО асинхронного выбора файла.
		// Настройки формы не читаются, запросы и компоновка не запускаются.
		ТекстCSV = ПолучитьCSVРезультатаНаСервере();
	Исключение
		Сообщить("CSV не сформирован: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Диалог = Новый ДиалогВыбораФайла(
		РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить последний сформированный результат ОСВ";
	Диалог.Фильтр = "CSV UTF-8 (*.csv)|*.csv";
	Диалог.Расширение = "csv";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.ПолноеИмяФайла = "ОСВ_"
		+ Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".csv";
	Диалог.Показать(Новый ОписаниеОповещения(
		"СохранитьCSVПослеВыбораФайла", ЭтотОбъект, ТекстCSV));

КонецПроцедуры


&НаКлиенте
Процедура СохранитьCSVПослеВыбораФайла(
	ВыбранныеФайлы, ТекстCSV) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ИмяФайла = ВыбранныеФайлы[0];
		Если НРег(Прав(ИмяФайла, 4)) <> ".csv" Тогда
			Сообщить("Выберите имя файла с расширением .csv.");
			Возврат;
		КонецЕсли;

		СохранитьCSVВФайлАсинх(ИмяФайла, ТекстCSV);
	Исключение
		Сообщить("Не удалось начать сохранение CSV: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры


&НаКлиенте
Асинх Процедура СохранитьCSVВФайлАсинх(ИмяФайла, ТекстCSV)

	Попытка
		ФайлНазначения = Новый Файл(ИмяФайла);
		Если Ждать ФайлНазначения.СуществуетАсинх() Тогда
			Сообщить("Файл уже существует. Выберите новое имя: " + ИмяФайла);
			Возврат;
		КонецЕсли;

		ДокументCSV = Новый ТекстовыйДокумент;
		ДокументCSV.УстановитьТекст(ТекстCSV);
		Ждать ДокументCSV.ЗаписатьАсинх(ИмяФайла, КодировкаТекста.UTF8,
			Символы.ВК + Символы.ПС);

		Если НЕ Ждать ФайлНазначения.СуществуетАсинх() Тогда
			Сообщить("Сохранение CSV не подтверждено: файл не создан.");
			Возврат;
		КонецЕсли;
	Исключение
		Сообщить("Не удалось сохранить CSV: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Сообщить("CSV сохранён: " + ИмяФайла);

КонецПроцедуры


&НаСервере
Функция ПолучитьCSVРезультатаНаСервере()

	Если Результат.ВысотаТаблицы = 0
		Или Результат.ШиринаТаблицы = 0 Тогда
		ВызватьИсключение "Сначала сформируйте ОСВ.";
	КонецЕсли;

	СтрокиCSV = Новый Массив;
	СтрокиCSV.Добавить(ЯчейкаCSV(
		"ОСВ: снимок последнего сформированного результата 1С. "
		+ "Изменения настроек после формирования не применяются. "
		+ "Итоги и детализацию нельзя складывать между собой."));

	Для НомерСтроки = 1 По Результат.ВысотаТаблицы Цикл
		ЯчейкиCSV = Новый Массив;
		Для НомерКолонки = 1 По Результат.ШиринаТаблицы Цикл
			ТекстЯчейки = Результат.Область(
				НомерСтроки, НомерКолонки).Текст;
			ЯчейкиCSV.Добавить(ЯчейкаCSV(ТекстЯчейки));
		КонецЦикла;
		СтрокиCSV.Добавить(СтрСоединить(ЯчейкиCSV, ";"));
	КонецЦикла;

	Возврат СтрСоединить(СтрокиCSV, Символы.ПС);

КонецФункции


&НаСервереБезКонтекста
Функция ЯчейкаCSV(ТекстЯчейки)

	Текст = Строка(ТекстЯчейки);
	// Не разрешать выполнение формул из наименований в электронной таблице.
	ПроверяемыйТекст = СокрЛП(СтрЗаменить(СтрЗаменить(
		СтрЗаменить(Текст, Символы.Таб, ""), Символы.ВК, ""),
		Символы.ПС, ""));
	ПервыйСимвол = Лев(ПроверяемыйТекст, 1);
	Если ПервыйСимвол = "=" Или ПервыйСимвол = "+"
		Или ПервыйСимвол = "-" Или ПервыйСимвол = "@" Тогда
		Текст = "'" + Текст;
	КонецЕсли;

	Кавычка = Символ(34);
	Возврат Кавычка
		+ СтрЗаменить(Текст, Кавычка, Кавычка + Кавычка)
		+ Кавычка;

КонецФункции
