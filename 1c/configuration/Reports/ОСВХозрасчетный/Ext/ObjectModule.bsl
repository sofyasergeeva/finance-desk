// Модуль объекта внешнего отчёта ОСВХозрасчетный.
// Формирование и настройки остаются штатными средствами СКД.
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	ПараметрыОтчета = НастройкиОтчета.ПараметрыДанных;
	Начало = ПараметрыОтчета.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("НачалоПериода"));
	Конец = ПараметрыОтчета.НайтиЗначениеПараметра(
		Новый ПараметрКомпоновкиДанных("КонецПериода"));

	Если Начало = Неопределено Или Конец = Неопределено Тогда
		ВызватьИсключение "В схеме ОСВ отсутствуют параметры начала или конца периода.";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Начало.Значение)
		Или НЕ ЗначениеЗаполнено(Конец.Значение) Тогда
		ВызватьИсключение "Укажите начало и конец периода ОСВ.";
	КонецЕсли;

	Если НачалоДня(Начало.Значение) > НачалоДня(Конец.Значение) Тогда
		ВызватьИсключение "Начало периода ОСВ не может быть позже его окончания.";
	КонецЕсли;

КонецПроцедуры
