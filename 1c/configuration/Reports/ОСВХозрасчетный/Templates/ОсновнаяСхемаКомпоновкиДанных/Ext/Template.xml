		<query>ВЫБРАТЬ
	О.Счет КАК Счет,
	О.Субконто1 КАК Субконто1,
	О.Субконто2 КАК Субконто2,
	О.Субконто3 КАК Субконто3,
	О.СуммаНачальныйОстатокДт КАК НачальныйОстатокДт,
	О.СуммаНачальныйОстатокКт КАК НачальныйОстатокКт,
	О.СуммаОборотДт КАК ОборотДт,
	О.СуммаОборотКт КАК ОборотКт,
	О.СуммаКонечныйОстатокДт КАК КонечныйОстатокДт,
	О.СуммаКонечныйОстатокКт КАК КонечныйОстатокКт
ПОМЕСТИТЬ ВТОСВ
ИЗ
	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ),
		КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)) КАК О
;

ВЫБРАТЬ
	Т.Счет КАК Счет,
	Т.Счет.Код КАК КодСчета,
	Т.Счет.Наименование КАК НаименованиеСчета,
	ВЫРАЗИТЬ(Т.Субконто1 КАК Справочник.Организации) КАК Организация,
	Т.Субконто2 КАК Аналитика2,
	Т.Субконто3 КАК Аналитика3,
	Т.НачальныйОстатокДт КАК НачальныйОстатокДт,
	Т.НачальныйОстатокКт КАК НачальныйОстатокКт,
	Т.ОборотДт КАК ОборотДт,
	Т.ОборотКт КАК ОборотКт,
	Т.КонечныйОстатокДт КАК КонечныйОстатокДт,
	Т.КонечныйОстатокКт КАК КонечныйОстатокКт
ИЗ
	ВТОСВ КАК Т
</query>
