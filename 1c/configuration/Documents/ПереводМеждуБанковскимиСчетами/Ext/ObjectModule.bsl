Процедура ПередЗаписью(
	Отказ,
	РежимЗаписи,
	РежимПроведения)

	Если Отказ Или ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;

	СохраненныйДокумент = Ссылка.ПолучитьОбъект();

	Если НЕ СохраненныйДокумент.Проведен Тогда
		Возврат;
	КонецЕсли;

	Если РежимЗаписи =
		РежимЗаписиДокумента.ОтменаПроведения Тогда

		СообщитьОбОшибке(
			Отказ,
			"Отмена проведения перевода в текущем "
			+ "учебном сценарии запрещена.");

		Возврат;

	КонецЕсли;

	Если Дата <> СохраненныйДокумент.Дата
		ИЛИ Организация <>
			СохраненныйДокумент.Организация
		ИЛИ БанковскийСчетСписания <>
			СохраненныйДокумент.БанковскийСчетСписания
		ИЛИ БанковскийСчетЗачисления <>
			СохраненныйДокумент.БанковскийСчетЗачисления
		ИЛИ Сумма <> СохраненныйДокумент.Сумма
		ИЛИ ПометкаУдаления <>
			СохраненныйДокумент.ПометкаУдаления Тогда

		СообщитьОбОшибке(
			Отказ,
			"Нельзя изменить дату, организацию, счета, "
			+ "сумму или пометку удаления проведённого перевода.");

	КонецЕсли;

КонецПроцедуры


Процедура ОбработкаПроверкиЗаполнения(
	Отказ,
	ПроверяемыеРеквизиты)

	ПроверитьРеквизитыПеревода(Отказ);

КонецПроцедуры


Процедура ОбработкаПроведения(
	Отказ,
	РежимПроведения)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Блокировки действуют до завершения транзакции проведения.
	Блокировки = Новый БлокировкаДанных;

	БлокировкаСчета = Блокировки.Добавить(
		"Справочник.БанковскиеСчета");
	БлокировкаСчета.Режим =
		РежимБлокировкиДанных.Разделяемый;
	БлокировкаСчета.УстановитьЗначение(
		"Ссылка", БанковскийСчетСписания);

	БлокировкаСчета = Блокировки.Добавить(
		"Справочник.БанковскиеСчета");
	БлокировкаСчета.Режим =
		РежимБлокировкиДанных.Разделяемый;
	БлокировкаСчета.УстановитьЗначение(
		"Ссылка", БанковскийСчетЗачисления);

	БлокировкаРегистра = Блокировки.Добавить(
		"РегистрБухгалтерии.Хозрасчетный");
	БлокировкаРегистра.Режим =
		РежимБлокировкиДанных.Исключительный;
	БлокировкаРегистра.УстановитьЗначение(
		"Счет",
		ПланыСчетов.Хозрасчетный.РасчетныеСчета);

	БлокировкаРегистра = Блокировки.Добавить(
		"РегистрБухгалтерии.Хозрасчетный");
	БлокировкаРегистра.Режим =
		РежимБлокировкиДанных.Исключительный;
	БлокировкаРегистра.УстановитьЗначение(
		"Счет",
		ПланыСчетов.Хозрасчетный.ДепозитныеСчета);

	Блокировки.Заблокировать();

	ПроверитьРеквизитыПеревода(Отказ);

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	БылПроведен = Ложь;

	Если НЕ ЭтоНовый() Тогда
		БылПроведен = Ссылка.ПолучитьОбъект().Проведен;
	КонецЕсли;

	Если НЕ БылПроведен Тогда

		Если ЕстьБолееПоздниеДвижения() Тогда

			СообщитьОбОшибке(
				Отказ,
				"По выбранным банковским счетам есть "
				+ "более поздние движения. "
				+ "Укажите дату перевода не раньше этих движений.",
				"Дата");

			Возврат;

		КонецЕсли;

	КонецЕсли;

	СчетСписания =
		ПолучитьСчетУчета(БанковскийСчетСписания);

	СчетЗачисления =
		ПолучитьСчетУчета(БанковскийСчетЗачисления);

	ДоступныйОстаток =
		ПолучитьДоступныйОстаток(СчетСписания);

	Если Сумма > ДоступныйОстаток Тогда

		СообщитьОбОшибке(
			Отказ,
			"Недостаточно средств на счёте списания. "
			+ "Доступный остаток на дату документа: "
			+ Формат(ДоступныйОстаток, "ЧДЦ=2")
			+ ".",
			"Сумма");

		Возврат;

	КонецЕсли;

	Движения.Хозрасчетный.Записывать = Истина;
	Движения.Хозрасчетный.Очистить();

	Движение = Движения.Хозрасчетный.Добавить();
	Движение.Период = Дата;
	Движение.Активность = Истина;
	Движение.Сумма = Сумма;
	Движение.СчетДт = СчетЗачисления;
	Движение.СчетКт = СчетСписания;

	Движение.СубконтоДт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
	] = Организация;

	Движение.СубконтоДт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.БанковскиеСчета
	] = БанковскийСчетЗачисления;

	Движение.СубконтоКт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
	] = Организация;

	Движение.СубконтоКт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.БанковскиеСчета
	] = БанковскийСчетСписания;

КонецПроцедуры


Процедура ОбработкаУдаленияПроведения(Отказ)

	СообщитьОбОшибке(
		Отказ,
		"Отмена проведения перевода в текущем "
		+ "учебном сценарии запрещена.");

КонецПроцедуры


Процедура ПроверитьРеквизитыПеревода(Отказ)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Дата) Тогда

		СообщитьОбОшибке(
			Отказ,
			"Укажите дату перевода.",
			"Дата");
		Возврат;

	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Организация) Тогда

		СообщитьОбОшибке(
			Отказ,
			"Укажите организацию.",
			"Организация");
		Возврат;

	КонецЕсли;

	Если Организация.ПометкаУдаления Тогда

		СообщитьОбОшибке(
			Отказ,
			"Организация помечена на удаление.",
			"Организация");
		Возврат;

	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(БанковскийСчетСписания)
		ИЛИ НЕ ЗначениеЗаполнено(
			БанковскийСчетЗачисления) Тогда

		СообщитьОбОшибке(
			Отказ,
			"Укажите счёт списания и счёт зачисления.");
		Возврат;

	КонецЕсли;

	Если БанковскийСчетСписания =
		БанковскийСчетЗачисления Тогда

		СообщитьОбОшибке(
			Отказ,
			"Счёт списания и счёт зачисления "
			+ "должны различаться.",
			"БанковскийСчетЗачисления");
		Возврат;

	КонецЕсли;

	Если Сумма <= 0 Тогда

		СообщитьОбОшибке(
			Отказ,
			"Сумма перевода должна быть больше нуля.",
			"Сумма");
		Возврат;

	КонецЕсли;

	Если НЕ БанковскийСчетДопустим(
		БанковскийСчетСписания) Тогда

		СообщитьОбОшибке(
			Отказ,
			"Счёт списания не найден, помечен на удаление "
			+ "или принадлежит другой организации.",
			"БанковскийСчетСписания");
		Возврат;

	КонецЕсли;

	Если НЕ БанковскийСчетДопустим(
		БанковскийСчетЗачисления) Тогда

		СообщитьОбОшибке(
			Отказ,
			"Счёт зачисления не найден, помечен на удаление "
			+ "или принадлежит другой организации.",
			"БанковскийСчетЗачисления");
		Возврат;

	КонецЕсли;

	Если ПолучитьСчетУчета(БанковскийСчетСписания) =
		ПолучитьСчетУчета(БанковскийСчетЗачисления) Тогда

		СообщитьОбОшибке(
			Отказ,
			"Разрешён перевод только между расчётным "
			+ "и депозитным банковскими счетами.");
		Возврат;

	КонецЕсли;

КонецПроцедуры


Функция БанковскийСчетДопустим(БанковскийСчет)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Счета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Ссылка = &БанковскийСчет
		|	И Счета.Организация = &Организация
		|	И НЕ Счета.ПометкаУдаления";

	Запрос.УстановитьПараметр(
		"БанковскийСчет", БанковскийСчет);
	Запрос.УстановитьПараметр(
		"Организация", Организация);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции


Функция ПолучитьСчетУчета(БанковскийСчет)

	Если БанковскийСчет.НазначениеСчета =
		Перечисления.НазначенияБанковскихСчетов.Депозитный Тогда

		Возврат ПланыСчетов.Хозрасчетный.ДепозитныеСчета;

	КонецЕсли;

	// Пустое назначение старых элементов означает счёт 51.
	Возврат ПланыСчетов.Хозрасчетный.РасчетныеСчета;

КонецФункции


Функция ПолучитьДоступныйОстаток(СчетУчета)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(
		|		ВЫБОР
		|			КОГДА Движения.СчетДт = &Счет
		|				И Движения.СубконтоДт1 = &Организация
		|				И Движения.СубконтоДт2 = &БанковскийСчет
		|			ТОГДА Движения.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ), 0)
		|	-
		|	ЕСТЬNULL(СУММА(
		|		ВЫБОР
		|			КОГДА Движения.СчетКт = &Счет
		|				И Движения.СубконтоКт1 = &Организация
		|				И Движения.СубконтоКт2 = &БанковскийСчет
		|			ТОГДА Движения.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ), 0) КАК Остаток
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто
		|		КАК Движения
		|ГДЕ
		|	Движения.Активность = ИСТИНА
		|	И Движения.Период <= &Дата
		|	И Движения.Регистратор <> &Регистратор
		|	И (Движения.СчетДт = &Счет
		|		ИЛИ Движения.СчетКт = &Счет)";

	Запрос.УстановитьПараметр("Счет", СчетУчета);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр(
		"БанковскийСчет", БанковскийСчетСписания);
	Запрос.УстановитьПараметр("Регистратор", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Остаток;
	КонецЕсли;

	Возврат 0;

КонецФункции


Функция ЕстьБолееПоздниеДвижения()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Движения.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто
		|		КАК Движения
		|ГДЕ
		|	Движения.Активность = ИСТИНА
		|	И Движения.Период > &Дата
		|	И Движения.Регистратор <> &Регистратор
		|	И (
		|		Движения.СубконтоДт2 = &СчетСписания
		|		ИЛИ Движения.СубконтоКт2 = &СчетСписания
		|		ИЛИ Движения.СубконтоДт2 = &СчетЗачисления
		|		ИЛИ Движения.СубконтоКт2 = &СчетЗачисления
		|	)";

	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Запрос.УстановитьПараметр(
		"СчетСписания", БанковскийСчетСписания);
	Запрос.УстановитьПараметр(
		"СчетЗачисления", БанковскийСчетЗачисления);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции


Процедура СообщитьОбОшибке(
	Отказ,
	ТекстСообщения,
	Поле = "")

	Отказ = Истина;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.УстановитьДанные(ЭтотОбъект);

	Если НЕ ПустаяСтрока(Поле) Тогда
		Сообщение.Поле = Поле;
	КонецЕсли;

	Сообщение.Сообщить();

КонецПроцедуры