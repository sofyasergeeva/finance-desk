&НаСервере
Процедура ПриСозданииНаСервере(
	Отказ,
	СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда

		Объект.Дата = ТекущаяДата();

		Если НЕ ЗначениеЗаполнено(
			Объект.Организация) Тогда

			ЕдинственнаяОрганизация =
				НСИСервер.ПолучитьЕдинственнуюОрганизацию();

			Если ЗначениеЗаполнено(
				ЕдинственнаяОрганизация) Тогда

				Объект.Организация =
					ЕдинственнаяОрганизация;

			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	Объект.БанковскийСчетСписания =
		ПредопределенноеЗначение(
			"Справочник.БанковскиеСчета.ПустаяСсылка");

	Объект.БанковскийСчетЗачисления =
		ПредопределенноеЗначение(
			"Справочник.БанковскиеСчета.ПустаяСсылка");

КонецПроцедуры