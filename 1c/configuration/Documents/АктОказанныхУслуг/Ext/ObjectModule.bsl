 Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ПересчитатьСуммыУслуг();

КонецПроцедуры


Процедура ПересчитатьСуммыУслуг()

	ИтогУслуг = 0;

	Для Каждого СтрокаУслуги Из Услуги Цикл

		СтрокаУслуги.Сумма =
			СтрокаУслуги.Количество * СтрокаУслуги.Цена;

		ИтогУслуг =
			ИтогУслуг + СтрокаУслуги.Сумма;

	КонецЦикла;

	СуммаДокумента = ИтогУслуг;

КонецПроцедуры
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.Хозрасчетный.Записывать = Истина;

	Движение = Движения.Хозрасчетный.Добавить();

	Движение.СчетДт =
		ПланыСчетов.Хозрасчетный.РасчетыСПокупателями;

	Движение.СчетКт =
		ПланыСчетов.Хозрасчетный.Выручка;

	Движение.Период = Дата;
	Движение.Сумма = СуммаДокумента;

	// Дт 62: Организация, Контрагент, Договор
	Движение.СубконтоДт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
	] = Организация;

	Движение.СубконтоДт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты
	] = Контрагент;

	Движение.СубконтоДт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры
	] = Договор;

	// Кт 90.01: Организация
	Движение.СубконтоКт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
	] = Организация;

КонецПроцедуры


Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Организация
	Если НЕ ЗначениеЗаполнено(Организация) Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Необходимо указать организацию.";
		Сообщение.Поле = "Организация";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// Контрагент
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Необходимо указать контрагента.";
		Сообщение.Поле = "Контрагент";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// Договор
	Если НЕ ЗначениеЗаполнено(Договор) Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Необходимо указать договор.";
		Сообщение.Поле = "Договор";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;
	
		// Договор должен соответствовать Организации и Контрагенту
	Если ЗначениеЗаполнено(Договор)
		И ЗначениеЗаполнено(Организация)
		И ЗначениеЗаполнено(Контрагент) Тогда

		Если НЕ ДоговорСоответствуетКонтексту(
			Договор,
			Контрагент,
			Организация
		) Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				"Выбранный договор не относится к указанным организации и контрагенту. Выберите подходящий договор.";
			Сообщение.Поле = "Договор";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;

	КонецЕсли;
	

	// Табличная часть должна содержать хотя бы одну услугу
	Если Услуги.Количество() = 0 Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Необходимо добавить хотя бы одну услугу.";
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	ИтогУслуг = 0;

	Для Каждого СтрокаУслуги Из Услуги Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаУслуги.Услуга) Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				"В каждой строке необходимо указать услугу.";
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;


		Если СтрокаУслуги.Количество <= 0 Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				"Количество услуги должно быть больше нуля.";
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;


		Если СтрокаУслуги.Цена <= 0 Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				"Цена услуги должна быть больше нуля.";
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;


		Если СтрокаУслуги.Сумма <= 0 Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				"Сумма строки услуги должна быть больше нуля.";
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;


		ИтогУслуг = ИтогУслуг + СтрокаУслуги.Сумма;

	КонецЦикла;


	// Общая сумма документа
	Если СуммаДокумента <= 0 Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			"Сумма документа должна быть больше нуля.";
		Сообщение.Поле = "СуммаДокумента";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// Контроль суммы
	Если ИтогУслуг <> СуммаДокумента Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			"Сумма документа должна совпадать с общей суммой услуг.";
		Сообщение.Поле = "СуммаДокумента";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	//{{__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Сделка") Тогда
		// Заполнение шапки
		Договор = ДанныеЗаполнения.Договор;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Организация = ДанныеЗаполнения.Организация;
		Сделка = ДанныеЗаполнения.Ссылка;
	КонецЕсли;
	//}}__КОНСТРУКТОР_ВВОД_НА_ОСНОВАНИИ
КонецПроцедуры

Функция ДоговорСоответствуетКонтексту(
	Договор,
	Контрагент,
	Организация
)

	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Ссылка = &Договор
		|	И Договоры.Контрагент = &Контрагент
		|	И Договоры.Организация = &Организация
		|	И НЕ Договоры.ПометкаУдаления";

	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат Выборка.Следующий();

КонецФункции
