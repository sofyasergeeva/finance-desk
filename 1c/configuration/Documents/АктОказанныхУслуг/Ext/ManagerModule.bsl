Функция СформироватьПечатнуюФорму(СсылкаНаДокумент) Экспорт

	ТабДок = Новый ТабличныйДокумент;

	Если НЕ ЗначениеЗаполнено(СсылкаНаДокумент) Тогда
		Возврат ТабДок;
	КонецЕсли;

	ДокументОбъект = СсылкаНаДокумент.ПолучитьОбъект();

	Макет = ПолучитьМакет("ПечатнаяФормаАкта");


	// =================================================
	// ЗАГОЛОВОК
	// =================================================

	Область = Макет.ПолучитьОбласть("Заголовок");

	Область.Область("R1C1").Текст =
		"АКТ № " + Строка(ДокументОбъект.Номер);

	Область.Область("R2C1").Текст =
		"оказанных услуг от "
		+ Формат(
			ДокументОбъект.Дата,
			"ДФ='dd.MM.yyyy'"
		);

	ТабДок.Вывести(Область);


	// =================================================
	// СТОРОНЫ
	// Область соответствует строкам 4–12 макета
	// =================================================

	Область = Макет.ПолучитьОбласть("Стороны");


	// -------------------------------------------------
	// Исполнитель
	// -------------------------------------------------

	Если ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда

		Область.Область("R1C2").Текст =
			Строка(ДокументОбъект.Организация);

		ИННОрганизации =
			Строка(ДокументОбъект.Организация.ИНН);

		КППОрганизации =
			Строка(ДокументОбъект.Организация.КПП);

		Область.Область("R2C2").Текст =
			СформироватьИННКПП(
				ИННОрганизации,
				КППОрганизации
			);

		Область.Область("R3C2").Текст =
			Строка(ДокументОбъект.Организация.Адрес);

	Иначе

		Область.Область("R1C2").Текст = "";
		Область.Область("R2C2").Текст = "";
		Область.Область("R3C2").Текст = "";

	КонецЕсли;


	// -------------------------------------------------
	// Заказчик
	// -------------------------------------------------

	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда

		Если ЗначениеЗаполнено(
			ДокументОбъект.Контрагент.ПолноеНаименование
		) Тогда

			Область.Область("R5C2").Текст =
				ДокументОбъект.Контрагент.ПолноеНаименование;

		Иначе

			Область.Область("R5C2").Текст =
				Строка(ДокументОбъект.Контрагент);

		КонецЕсли;


		ИННКонтрагента =
			Строка(ДокументОбъект.Контрагент.ИНН);

		КППКонтрагента =
			Строка(ДокументОбъект.Контрагент.КПП);

		Область.Область("R6C2").Текст =
			СформироватьИННКПП(
				ИННКонтрагента,
				КППКонтрагента
			);

		Область.Область("R7C2").Текст =
			Строка(ДокументОбъект.Контрагент.Адрес);

	Иначе

		Область.Область("R5C2").Текст = "";
		Область.Область("R6C2").Текст = "";
		Область.Область("R7C2").Текст = "";

	КонецЕсли;


	// -------------------------------------------------
	// Договор
	// -------------------------------------------------

	Если ЗначениеЗаполнено(ДокументОбъект.Договор) Тогда

		Область.Область("R9C2").Текст =
			Строка(ДокументОбъект.Договор);

	Иначе

		Область.Область("R9C2").Текст = "";

	КонецЕсли;

	ТабДок.Вывести(Область);


	// =================================================
	// ШАПКА ТАБЛИЦЫ
	// =================================================

	Область = Макет.ПолучитьОбласть("ШапкаТаблицы");

	ТабДок.Вывести(Область);


	// =================================================
	// СТРОКИ УСЛУГ
	// =================================================

	НомерСтроки = 0;

	Для Каждого СтрокаУслуги Из ДокументОбъект.Услуги Цикл

		НомерСтроки = НомерСтроки + 1;

		Область = Макет.ПолучитьОбласть("Строка");


		// №
		Область.Область("R1C1").Текст =
			Строка(НомерСтроки);


		// Услуга
		Область.Область("R1C2").Текст =
			Строка(СтрокаУслуги.Услуга);


		// Количество
		Область.Область("R1C3").Текст =
			Формат(
				СтрокаУслуги.Количество,
				"ЧДЦ=2"
			);


		// Единица измерения
		Если ЗначениеЗаполнено(СтрокаУслуги.Услуга) Тогда

			Область.Область("R1C4").Текст =
				Строка(
					СтрокаУслуги.Услуга.ЕдиницаИзмерения
				);

		Иначе

			Область.Область("R1C4").Текст = "";

		КонецЕсли;


		// Цена
		Область.Область("R1C5").Текст =
			Формат(
				СтрокаУслуги.Цена,
				"ЧДЦ=2; ЧРГ=' '"
			);


		// Сумма
		Область.Область("R1C6").Текст =
			Формат(
				СтрокаУслуги.Сумма,
				"ЧДЦ=2; ЧРГ=' '"
			);


		ТабДок.Вывести(Область);

	КонецЦикла;


	// =================================================
	// ИТОГ
	// =================================================

	Область = Макет.ПолучитьОбласть("Итог");

	Область.Область("R1C6").Текст =
		Формат(
			ДокументОбъект.СуммаДокумента,
			"ЧДЦ=2; ЧРГ=' '"
		);

	ТабДок.Вывести(Область);


	// =================================================
	// ПОДПИСИ
	// Область соответствует строкам 19–24 макета
	// =================================================

	Область = Макет.ПолучитьОбласть("Подписи");


	// Исполнитель
	Если ЗначениеЗаполнено(ДокументОбъект.Организация) Тогда

		Область.Область("R6C2").Текст =
			Строка(ДокументОбъект.Организация);

	Иначе

		Область.Область("R6C2").Текст = "";

	КонецЕсли;


	// Заказчик
	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда

		Если ЗначениеЗаполнено(
			ДокументОбъект.Контрагент.ПолноеНаименование
		) Тогда

			Область.Область("R6C6").Текст =
				ДокументОбъект.Контрагент.ПолноеНаименование;

		Иначе

			Область.Область("R6C6").Текст =
				Строка(ДокументОбъект.Контрагент);

		КонецЕсли;

	Иначе

		Область.Область("R6C6").Текст = "";

	КонецЕсли;


	ТабДок.Вывести(Область);


	// =================================================
	// ПАРАМЕТРЫ ПРОСМОТРА
	// =================================================

	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы =
		ОриентацияСтраницы.Портрет;

	Возврат ТабДок;

КонецФункции


// =====================================================
// Формирует строку ИНН / КПП.
// Не показывает один "/" при незаполненных реквизитах.
// =====================================================

Функция СформироватьИННКПП(ИНН, КПП)

	Если ПустаяСтрока(ИНН)
		И ПустаяСтрока(КПП) Тогда

		Возврат "";

	ИначеЕсли ПустаяСтрока(КПП) Тогда

		Возврат ИНН;

	ИначеЕсли ПустаяСтрока(ИНН) Тогда

		Возврат КПП;

	Иначе

		Возврат ИНН + " / " + КПП;

	КонецЕсли;

КонецФункции