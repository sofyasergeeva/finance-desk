&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда

		ЕдинственнаяОрганизация =
			НСИСервер.ПолучитьЕдинственнуюОрганизацию();

		Если ЗначениеЗаполнено(ЕдинственнаяОрганизация) Тогда
			Объект.Организация = ЕдинственнаяОрганизация;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УслугиУслугаПриИзменении(Элемент)
	СтрокаУслуги = Элементы.Услуги.ТекущиеДанные;

	Если СтрокаУслуги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтрокаУслуги.Услуга) Тогда

		СтрокаУслуги.Цена = 0;
		СтрокаУслуги.Сумма = 0;

		ПересчитатьСуммуДокумента();

		Возврат;

	КонецЕсли;

	Если СтрокаУслуги.Количество <= 0 Тогда
		СтрокаУслуги.Количество = 1;
	КонецЕсли;

	СтрокаУслуги.Цена =
		ПолучитьЦенуУслуги(СтрокаУслуги.Услуга);

	ПересчитатьСтрокуУслуги(СтрокаУслуги);
	ПересчитатьСуммуДокумента();
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ПолучитьЦенуУслуги(Услуга)

	Если НЕ ЗначениеЗаполнено(Услуга) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Услуга.ЦенаПоУмолчанию;

КонецФункции


&НаКлиенте
Процедура ПересчитатьСтрокуУслуги(СтрокаУслуги)

	Если СтрокаУслуги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаУслуги.Сумма =
		СтрокаУслуги.Количество * СтрокаУслуги.Цена;

КонецПроцедуры


&НаКлиенте
Процедура ПересчитатьСуммуДокумента()

	ИтогДокумента = 0;

	Для Каждого СтрокаУслуги Из Объект.Услуги Цикл

		ИтогДокумента =
			ИтогДокумента + СтрокаУслуги.Сумма;

	КонецЦикла;

	Объект.СуммаДокумента = ИтогДокумента;

КонецПроцедуры

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	СтрокаУслуги = Элементы.Услуги.ТекущиеДанные;

	Если СтрокаУслуги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПересчитатьСтрокуУслуги(СтрокаУслуги);
	ПересчитатьСуммуДокумента();
КонецПроцедуры

&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
	СтрокаУслуги = Элементы.Услуги.ТекущиеДанные;

	Если СтрокаУслуги = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПересчитатьСтрокуУслуги(СтрокаУслуги);
	ПересчитатьСуммуДокумента();
КонецПроцедуры

&НаКлиенте
Процедура УслугиПослеУдаления(Элемент)
	ПересчитатьСуммуДокумента();
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	Объект.Договор = ПолучитьПустуюСсылкуДоговора();

КонецПроцедуры


&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	Объект.Договор = ПолучитьПустуюСсылкуДоговора();

КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьПустуюСсылкуДоговора()

	Возврат Справочники.Договоры.ПустаяСсылка();

КонецФункции

&НаКлиенте
Процедура ПечатьАкта(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда

		Сообщить(
			"Перед печатью необходимо записать документ."
		);

		Возврат;

	КонецЕсли;

	ТабДок = ПолучитьПечатнуюФормуНаСервере();

	ТабДок.Показать(
		"Акт оказанных услуг"
	);

КонецПроцедуры


&НаСервере
Функция ПолучитьПечатнуюФормуНаСервере()

	Возврат
		Документы.АктОказанныхУслуг.СформироватьПечатнуюФорму(
			Объект.Ссылка
		);

КонецФункции