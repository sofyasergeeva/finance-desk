&НаСервере
Процедура ПриСозданииНаСервере(
	Отказ,
	СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Дата = ТекущаяДата();
		
		Если ЗначениеЗаполнено(Параметры.ОрганизацияОснование) Тогда
	Объект.Организация = Параметры.ОрганизацияОснование;
КонецЕсли;

Если ЗначениеЗаполнено(Параметры.СотрудникОснование) Тогда
	Объект.Сотрудник = Параметры.СотрудникОснование;
КонецЕсли;

	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда

		ЕдинственнаяОрганизация =
			НСИСервер.ПолучитьЕдинственнуюОрганизацию();

		Если ЗначениеЗаполнено(ЕдинственнаяОрганизация) Тогда
			Объект.Организация =
				ЕдинственнаяОрганизация;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьВидимостьПолей();
	ОбновитьОстатокПодотчетаНаСервере(Истина);

КонецПроцедуры


&НаКлиенте
Процедура ДатаПриИзменении(Элемент)

	ОбновитьОстатокПодотчетаНаСервере(Истина);

КонецПроцедуры


&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Сумма = 0;
	КонецЕсли;

	ОбновитьОстатокПодотчетаНаСервере(Истина);

КонецПроцедуры


&НаКлиенте
Процедура ВидДенежныхСредствПриИзменении(
	Элемент)

	ДенежныеСредстваКасса =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.Касса");

	ДенежныеСредстваБанк =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.БанковскийСчет");

	Если Объект.ВидДенежныхСредств =
		ДенежныеСредстваКасса Тогда

		Объект.БанковскийСчет =
			ПолучитьПустуюСсылкуБанковскогоСчета();

	ИначеЕсли Объект.ВидДенежныхСредств =
		ДенежныеСредстваБанк Тогда

		Объект.Касса =
			ПолучитьПустуюСсылкуКассы();

	Иначе

		Объект.Касса =
			ПолучитьПустуюСсылкуКассы();

		Объект.БанковскийСчет =
			ПолучитьПустуюСсылкуБанковскогоСчета();

	КонецЕсли;

	ОбновитьВидимостьПолей();

КонецПроцедуры


&НаКлиенте
Процедура ОбновитьВидимостьПолей()

	ДенежныеСредстваКасса =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.Касса");

	ДенежныеСредстваБанк =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.БанковскийСчет");

	ЭтоКасса =
		Объект.ВидДенежныхСредств =
			ДенежныеСредстваКасса;

	ЭтоБанк =
		Объект.ВидДенежныхСредств =
			ДенежныеСредстваБанк;

	Элементы.Касса.Видимость = ЭтоКасса;
	Элементы.БанковскийСчет.Видимость = ЭтоБанк;

КонецПроцедуры


&НаСервере
Процедура ОбновитьОстатокПодотчетаНаСервере(
	УстановитьСуммуПоУмолчанию = Ложь)

	ОстатокПодотчета =
		ФинансыСервер.ПолучитьОстатокПодотчета(
			Объект.Организация,
			Объект.Сотрудник,
			Объект.Дата
		);

	Если УстановитьСуммуПоУмолчанию
		И Объект.Сумма = 0
		И ОстатокПодотчета > 0 Тогда

		Объект.Сумма = ОстатокПодотчета;

	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	Объект.Касса =
		ПолучитьПустуюСсылкуКассы();

	Объект.БанковскийСчет =
		ПолучитьПустуюСсылкуБанковскогоСчета();

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Сумма = 0;
	КонецЕсли;

	ОбновитьОстатокПодотчетаНаСервере(Истина);

КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьПустуюСсылкуКассы()

	Возврат Справочники.Кассы.ПустаяСсылка();

КонецФункции


&НаСервереБезКонтекста
Функция ПолучитьПустуюСсылкуБанковскогоСчета()

	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();

КонецФункции