&НаСервере
Процедура ОбновитьДолгПоОплатеТрудаНаСервере()

	ЗадолженностьПоОплатеТруда = 0;

	Если Объект.ВидОперации <>
		Перечисления.ВидыОперацийСписанияДенежныхСредств.ВыплатаЗарплаты Тогда

		Возврат;

	КонецЕсли;

	ЗадолженностьПоОплатеТруда =
		ФинансыСервер.ПолучитьДолгПоОплатеТруда(
			Объект.Организация,
			Объект.Сотрудник,
			Объект.Дата,
			Объект.Ссылка);

КонецПроцедуры


&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)

	ОбновитьДолгПоОплатеТрудаНаСервере();

КонецПроцедуры