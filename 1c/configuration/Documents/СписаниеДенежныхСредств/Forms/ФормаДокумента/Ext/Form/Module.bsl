&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Дата = ТекущаяДата();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда

		ЕдинственнаяОрганизация =
			НСИСервер.ПолучитьЕдинственнуюОрганизацию();

		Если ЗначениеЗаполнено(ЕдинственнаяОрганизация) Тогда
			Объект.Организация = ЕдинственнаяОрганизация;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьВидимостьПолей();
	ОбновитьЗадолженностьПоставщикуНаСервере(Истина);
	ОбновитьДолгПоОплатеТрудаНаСервере();

КонецПроцедуры


&НаКлиенте
Процедура ДатаПриИзменении(Элемент)

	ОбновитьЗадолженностьПоставщикуНаСервере(Истина);
	ОбновитьДолгПоОплатеТрудаНаСервере();

КонецПроцедуры


&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)

	ОперацияПоставщику =
		ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийСписанияДенежныхСредств.Поставщику");

	ОперацияПодотчет =
		ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийСписанияДенежныхСредств.Подотчёт");

	Если Объект.ВидОперации = ОперацияПоставщику Тогда

		Объект.Сотрудник =
			ПолучитьПустуюСсылкуСотрудника();

	ИначеЕсли Объект.ВидОперации = ОперацияПодотчет
		ИЛИ Объект.ВидОперации =
			ПредопределенноеЗначение(
				"Перечисление.ВидыОперацийСписанияДенежныхСредств.ВыплатаЗарплаты") Тогда

		Объект.ПолучениеУслуг =
			ПолучитьПустуюСсылкуПолученияУслуг();

		Объект.Контрагент =
			ПолучитьПустуюСсылкуКонтрагента();

		Объект.Договор =
			ПолучитьПустуюСсылкуДоговора();

	Иначе

		Объект.ПолучениеУслуг =
			ПолучитьПустуюСсылкуПолученияУслуг();

		Объект.Контрагент =
			ПолучитьПустуюСсылкуКонтрагента();

		Объект.Договор =
			ПолучитьПустуюСсылкуДоговора();

		Объект.Сотрудник =
			ПолучитьПустуюСсылкуСотрудника();

	КонецЕсли;

	ОбновитьВидимостьПолей();

	Если Объект.ВидОперации = ОперацияПоставщику Тогда
		ОбновитьЗадолженностьПоставщикуНаСервере(Истина);
	Иначе
		ТекущаяЗадолженностьПоставщику = 0;
	КонецЕсли;
	
	ОбновитьДолгПоОплатеТрудаНаСервере();

КонецПроцедуры


&НаКлиенте
Процедура ВидДенежныхСредствПриИзменении(Элемент)

	ДенежныеСредстваКасса =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.Касса");

	ДенежныеСредстваБанк =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.БанковскийСчет");

	Если Объект.ВидДенежныхСредств = ДенежныеСредстваКасса Тогда

		Объект.БанковскийСчет =
			ПолучитьПустуюСсылкуБанковскогоСчета();

	ИначеЕсли Объект.ВидДенежныхСредств = ДенежныеСредстваБанк Тогда

		Объект.Касса =
			ПолучитьПустуюСсылкуКассы();

	Иначе

		Объект.Касса =
			ПолучитьПустуюСсылкуКассы();

		Объект.БанковскийСчет =
			ПолучитьПустуюСсылкуБанковскогоСчета();

	КонецЕсли;

	ОбновитьВидимостьПолей();

КонецПроцедуры


&НаКлиенте
Процедура ОбновитьВидимостьПолей()

	ОперацияПоставщику =
		ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийСписанияДенежныхСредств.Поставщику");

	ОперацияПодотчет =
		ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийСписанияДенежныхСредств.Подотчёт");

	ДенежныеСредстваКасса =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.Касса");

	ДенежныеСредстваБанк =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.БанковскийСчет");

	ЭтоПоставщику =
		Объект.ВидОперации = ОперацияПоставщику;

	ЭтоПодотчет =
		Объект.ВидОперации = ОперацияПодотчет;

	ЭтоКасса =
		Объект.ВидДенежныхСредств = ДенежныеСредстваКасса;

	ЭтоБанк =
		Объект.ВидДенежныхСредств = ДенежныеСредстваБанк;

	Элементы.ПолучениеУслуг.Видимость = ЭтоПоставщику;
	Элементы.Контрагент.Видимость = ЭтоПоставщику;
	Элементы.Договор.Видимость = ЭтоПоставщику;

	ЭтоЗарплата = Объект.ВидОперации =
		ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийСписанияДенежныхСредств.ВыплатаЗарплаты");

	Элементы.Сотрудник.Видимость =
		ЭтоПодотчет Или ЭтоЗарплата;

	Элементы.ЗадолженностьПоОплатеТруда.Видимость =
		ЭтоЗарплата;

	Элементы.Касса.Видимость = ЭтоКасса;
	Элементы.БанковскийСчет.Видимость = ЭтоБанк;

	Элементы.ТекущаяЗадолженностьПоставщику.Видимость =
		ЭтоПоставщику;

КонецПроцедуры


&НаСервере
Процедура ОбновитьЗадолженностьПоставщикуНаСервере(
	УстановитьСуммуПоУмолчанию = Ложь)

	ОперацияПоставщику =
		Перечисления.ВидыОперацийСписанияДенежныхСредств.Поставщику;

	Если Объект.ВидОперации <> ОперацияПоставщику Тогда

		ТекущаяЗадолженностьПоставщику = 0;
		Возврат;

	КонецЕсли;

	ТекущаяЗадолженностьПоставщику =
		ФинансыСервер.ПолучитьДолгПоставщику(
			Объект.Организация,
			Объект.Контрагент,
			Объект.Договор,
			Объект.Дата
		);

	Если УстановитьСуммуПоУмолчанию
		И Объект.Сумма = 0
		И ТекущаяЗадолженностьПоставщику > 0 Тогда

		Объект.Сумма =
			ТекущаяЗадолженностьПоставщику;

	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)

	ОбновитьЗадолженностьПоставщикуНаСервере(Истина);

КонецПроцедуры


&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	Объект.Договор =
		ПолучитьПустуюСсылкуДоговора();

	ТекущаяЗадолженностьПоставщику = 0;

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Сумма = 0;
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	Объект.Договор =
		ПолучитьПустуюСсылкуДоговора();

	Объект.Касса =
		ПолучитьПустуюСсылкуКассы();

	Объект.БанковскийСчет =
		ПолучитьПустуюСсылкуБанковскогоСчета();

	ТекущаяЗадолженностьПоставщику = 0;

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Сумма = 0;
	КонецЕсли;
	
	ОбновитьДолгПоОплатеТрудаНаСервере();

КонецПроцедуры


