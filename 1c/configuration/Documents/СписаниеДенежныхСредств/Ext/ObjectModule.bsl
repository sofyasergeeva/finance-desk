Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
		Если НЕ (
		ВидОперации =
			Перечисления.ВидыОперацийСписанияДенежныхСредств.Поставщику
		ИЛИ ВидОперации =
			Перечисления.ВидыОперацийСписанияДенежныхСредств.Подотчёт
		ИЛИ ЭтоВыплатаЗарплаты()) Тогда

		ОшибкаВыплаты(
			Отказ,
			"Неизвестный или незаполненный вид операции.");
		Возврат;

	КонецЕсли;

	Если ЭтоВыплатаЗарплаты() Тогда

		ЗаблокироватьДанныеВыплаты();

		ПроверитьВыплатуЗарплаты(Отказ);

		Если Отказ Тогда
			Возврат;
		КонецЕсли;

	КонецЕсли;
	
	ПроверитьБанковскийСчетДляСчета51(Отказ);

	Если Отказ Тогда
	    Возврат;
	КонецЕсли;

	Движения.Хозрасчетный.Записывать = Истина;

	Движение = Движения.Хозрасчетный.Добавить();

	Движение.Период = Дата;
	Движение.Сумма = Сумма;


	// -------------------------------------------------
	// ДЕБЕТ
	// Поставщику -> 60
	// Подотчёт   -> 71
	// -------------------------------------------------

	Если ВидОперации =
		Перечисления.ВидыОперацийСписанияДенежныхСредств.Поставщику Тогда

		Движение.СчетДт =
			ПланыСчетов.Хозрасчетный.РасчетыСПоставщиками;

		Движение.СубконтоДт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
		] = Организация;

		Движение.СубконтоДт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты
		] = Контрагент;

		Движение.СубконтоДт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры
		] = Договор;


	ИначеЕсли ВидОперации =
		Перечисления.ВидыОперацийСписанияДенежныхСредств.Подотчёт Тогда

		Движение.СчетДт =
			ПланыСчетов.Хозрасчетный.РасчетыСППодотчетнымиЛицами;

		Движение.СубконтоДт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
		] = Организация;

		Движение.СубконтоДт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Сотрудники
		] = Сотрудник;
		
	ИначеЕсли ЭтоВыплатаЗарплаты() Тогда

		Движение.СчетДт =
			ПланыСчетов.Хозрасчетный.РасчетыПоОплатеТруда;

		Движение.СубконтоДт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
		] = Организация;

		Движение.СубконтоДт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Сотрудники
		] = Сотрудник;

	КонецЕсли;


	// -------------------------------------------------
	// КРЕДИТ
	// Касса          -> 50
	// БанковскийСчет -> 51
	// -------------------------------------------------

	Если ВидДенежныхСредств =
		Перечисления.ВидыДенежныхСредств.Касса Тогда

		Движение.СчетКт =
			ПланыСчетов.Хозрасчетный.Касса;

		Движение.СубконтоКт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
		] = Организация;

		Движение.СубконтоКт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Кассы
		] = Касса;


	ИначеЕсли ВидДенежныхСредств =
		Перечисления.ВидыДенежныхСредств.БанковскийСчет Тогда

		Движение.СчетКт =
			ПланыСчетов.Хозрасчетный.РасчетныеСчета;

		Движение.СубконтоКт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
		] = Организация;

		Движение.СубконтоКт[
			ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.БанковскиеСчета
		] = БанковскийСчет;

	КонецЕсли;

КонецПроцедуры


Процедура ОбработкаПроверкиЗаполнения(
	Отказ,
	ПроверяемыеРеквизиты)
	
	Если ЭтоВыплатаЗарплаты() Тогда
		ПроверитьВыплатуЗарплаты(Отказ);
		Возврат;
	КонецЕсли;
	
	ПроверитьБанковскийСчетДляСчета51(Отказ);

	Если Отказ Тогда
	    Возврат;
	КонецЕсли;

	// -------------------------------------------------
	// Организация
	// -------------------------------------------------

	Если НЕ ЗначениеЗаполнено(Организация) Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			"Необходимо указать организацию.";
		Сообщение.Поле = "Организация";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// -------------------------------------------------
	// Вид операции
	// -------------------------------------------------

	Если НЕ ЗначениеЗаполнено(ВидОперации) Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			"Необходимо указать вид операции.";
		Сообщение.Поле = "ВидОперации";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// -------------------------------------------------
	// Вид денежных средств
	// -------------------------------------------------

	Если НЕ ЗначениеЗаполнено(ВидДенежныхСредств) Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			"Необходимо указать вид денежных средств.";
		Сообщение.Поле = "ВидДенежныхСредств";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// -------------------------------------------------
	// Сумма
	// -------------------------------------------------

	Если Сумма <= 0 Тогда

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			"Сумма документа должна быть больше нуля.";
		Сообщение.Поле = "Сумма";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// -------------------------------------------------
	// Поставщику
	// -------------------------------------------------

	Если ВидОперации =
		Перечисления.ВидыОперацийСписанияДенежныхСредств.Поставщику Тогда

		Если НЕ ЗначениеЗаполнено(Контрагент) Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				"Для операции ""Поставщику"" необходимо указать поставщика.";
			Сообщение.Поле = "Контрагент";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;


		Если НЕ ЗначениеЗаполнено(Договор) Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				"Для операции ""Поставщику"" необходимо указать договор.";
			Сообщение.Поле = "Договор";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;


		Если ЗначениеЗаполнено(Договор)
			И ЗначениеЗаполнено(Организация)
			И ЗначениеЗаполнено(Контрагент) Тогда

			Если НЕ ДоговорСоответствуетКонтексту(
				Договор,
				Контрагент,
				Организация
			) Тогда

				Сообщение =
					Новый СообщениеПользователю;

				Сообщение.Текст =
					"Выбранный договор не относится к указанным организации и поставщику. Выберите подходящий договор.";

				Сообщение.Поле = "Договор";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();

				Отказ = Истина;

			КонецЕсли;

		КонецЕсли;


		// -------------------------------------------------
		// UX-06: контроль задолженности поставщику
		// -------------------------------------------------

		Если ЗначениеЗаполнено(Организация)
			И ЗначениеЗаполнено(Контрагент)
			И ЗначениеЗаполнено(Договор)
			И Сумма > 0 Тогда

			ДолгПоставщику =
				ФинансыСервер.ПолучитьДолгПоставщику(
					Организация,
					Контрагент,
					Договор,
					Дата,
					Ссылка
				);

			Если ДолгПоставщику <= 0 Тогда

				Сообщение =
					Новый СообщениеПользователю;

				Сообщение.Текст =
					"По выбранному договору задолженность перед поставщиком отсутствует. Оплата не требуется.";

				Сообщение.Поле = "Сумма";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();

				Отказ = Истина;

			ИначеЕсли Сумма > ДолгПоставщику Тогда

				Сообщение =
					Новый СообщениеПользователю;

				Сообщение.Текст =
					"Сумма оплаты превышает текущую задолженность перед поставщиком. Максимально допустимая сумма: "
					+ Формат(
						ДолгПоставщику,
						"ЧДЦ=2")
					+ ".";

				Сообщение.Поле = "Сумма";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();

				Отказ = Истина;

			КонецЕсли;

		КонецЕсли;

	КонецЕсли;


	// -------------------------------------------------
	// Подотчёт
	// -------------------------------------------------

	Если ВидОперации =
		Перечисления.ВидыОперацийСписанияДенежныхСредств.Подотчёт Тогда

		Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				"Для операции ""Подотчёт"" необходимо указать сотрудника.";
			Сообщение.Поле = "Сотрудник";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;

	КонецЕсли;


	// -------------------------------------------------
	// Источник денежных средств
	// -------------------------------------------------

	Если ВидДенежныхСредств =
		Перечисления.ВидыДенежныхСредств.Касса Тогда

		Если НЕ ЗначениеЗаполнено(Касса) Тогда

			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				"Для вида денежных средств ""Касса"" необходимо указать кассу.";
			Сообщение.Поле = "Касса";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;


		Если ЗначениеЗаполнено(Касса)
			И ЗначениеЗаполнено(Организация) Тогда

			Если НЕ КассаСоответствуетОрганизации(
				Касса,
				Организация
			) Тогда

				Сообщение =
					Новый СообщениеПользователю;

				Сообщение.Текст =
					"Выбранная касса не относится к указанной организации.";

				Сообщение.Поле = "Касса";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();

				Отказ = Истина;

			КонецЕсли;

		КонецЕсли;


	ИначеЕсли ВидДенежныхСредств =
		Перечисления.ВидыДенежныхСредств.БанковскийСчет Тогда

		Если НЕ ЗначениеЗаполнено(БанковскийСчет) Тогда

			Сообщение =
				Новый СообщениеПользователю;

			Сообщение.Текст =
				"Для вида денежных средств ""Банковский счёт"" необходимо указать банковский счёт.";

			Сообщение.Поле = "БанковскийСчет";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;


		Если ЗначениеЗаполнено(БанковскийСчет)
			И ЗначениеЗаполнено(Организация) Тогда

			Если НЕ БанковскийСчетСоответствуетОрганизации(
				БанковскийСчет,
				Организация
			) Тогда

				Сообщение =
					Новый СообщениеПользователю;

				Сообщение.Текст =
					"Выбранный банковский счёт не относится к указанной организации.";

				Сообщение.Поле = "БанковскийСчет";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();

				Отказ = Истина;

			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры


Процедура ОбработкаЗаполнения(
	ДанныеЗаполнения,
	СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) =
		Тип("ДокументСсылка.ПолучениеУслуг") Тогда

		Договор =
			ДанныеЗаполнения.Договор;

		Контрагент =
			ДанныеЗаполнения.Контрагент;

		Организация =
			ДанныеЗаполнения.Организация;

		ПолучениеУслуг =
			ДанныеЗаполнения.Ссылка;

		ВидОперации =
			Перечисления.ВидыОперацийСписанияДенежныхСредств.Поставщику;

		Дата = ТекущаяДата();

	КонецЕсли;

КонецПроцедуры


Функция ДоговорСоответствуетКонтексту(
	Договор,
	Контрагент,
	Организация)

	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Ссылка = &Договор
		|	И Договоры.Контрагент = &Контрагент
		|	И Договоры.Организация = &Организация
		|	И НЕ Договоры.ПометкаУдаления";

	Запрос.УстановитьПараметр(
		"Договор",
		Договор);

	Запрос.УстановитьПараметр(
		"Контрагент",
		Контрагент);

	Запрос.УстановитьПараметр(
		"Организация",
		Организация);

	Выборка =
		Запрос.Выполнить().Выбрать();

	Возврат Выборка.Следующий();

КонецФункции


Функция КассаСоответствуетОрганизации(
	Касса,
	Организация)

	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Кассы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Кассы КАК Кассы
		|ГДЕ
		|	Кассы.Ссылка = &Касса
		|	И Кассы.Организация = &Организация
		|	И НЕ Кассы.ПометкаУдаления";

	Запрос.УстановитьПараметр(
		"Касса",
		Касса);

	Запрос.УстановитьПараметр(
		"Организация",
		Организация);

	Выборка =
		Запрос.Выполнить().Выбрать();

	Возврат Выборка.Следующий();

КонецФункции


Функция БанковскийСчетСоответствуетОрганизации(
	БанковскийСчет,
	Организация)

	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	БанковскиеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Ссылка = &БанковскийСчет
		|	И БанковскиеСчета.Организация = &Организация
		|	И НЕ БанковскиеСчета.ПометкаУдаления";

	Запрос.УстановитьПараметр(
		"БанковскийСчет",
		БанковскийСчет);

	Запрос.УстановитьПараметр(
		"Организация",
		Организация);

	Выборка =
		Запрос.Выполнить().Выбрать();

	Возврат Выборка.Следующий();

КонецФункции

Процедура ПроверитьБанковскийСчетДляСчета51(Отказ)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ВидДенежныхСредств <>
		Перечисления.ВидыДенежныхСредств.БанковскийСчет Тогда

		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Счета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	Счета.Ссылка = &БанковскийСчет
		|	И Счета.Организация = &Организация
		|	И НЕ Счета.ПометкаУдаления
		|	И (
		|		Счета.НазначениеСчета = &Расчетный
		|		ИЛИ Счета.НазначениеСчета =
		|			&ПустоеНазначение
		|	)";

	Запрос.УстановитьПараметр(
		"БанковскийСчет", БанковскийСчет);

	Запрос.УстановитьПараметр(
		"Организация", Организация);

	Запрос.УстановитьПараметр(
		"Расчетный",
		Перечисления.НазначенияБанковскихСчетов.Расчетный);

	Запрос.УстановитьПараметр(
		"ПустоеНазначение",
		Перечисления.НазначенияБанковскихСчетов.ПустаяСсылка());

	Если Запрос.Выполнить().Пустой() Тогда

		Отказ = Истина;

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			"Для этой операции требуется расчётный банковский "
			+ "счёт указанной организации, не помеченный "
			+ "на удаление. Депозитный счёт использовать нельзя. "
			+ "Пустое назначение ранее созданного счёта "
			+ "считается расчётным.";
		Сообщение.Поле = "БанковскийСчет";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

	КонецЕсли;

КонецПроцедуры

Функция ЭтоВыплатаЗарплаты()

	Возврат ВидОперации =
		Перечисления.ВидыОперацийСписанияДенежныхСредств.ВыплатаЗарплаты;

КонецФункции


Процедура ПроверитьВыплатуЗарплаты(Отказ)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Дата)
		ИЛИ НЕ ЗначениеЗаполнено(Организация)
		ИЛИ НЕ ЗначениеЗаполнено(Сотрудник)
		ИЛИ Сумма <= 0 Тогда

		ОшибкаВыплаты(
			Отказ,
			"Для выплаты укажите дату, организацию, "
			+ "сотрудника и положительную сумму.");
		Возврат;

	КонецЕсли;

	Если Организация.ПометкаУдаления
		ИЛИ Сотрудник.ПометкаУдаления Тогда

		ОшибкаВыплаты(
			Отказ,
			"Организация или сотрудник помечены на удаление.");
		Возврат;

	КонецЕсли;

	Если ЗначениеЗаполнено(Контрагент)
		ИЛИ ЗначениеЗаполнено(Договор)
		ИЛИ ЗначениеЗаполнено(ПолучениеУслуг) Тогда

		ОшибкаВыплаты(
			Отказ,
			"У выплаты зарплаты не должны быть заполнены "
			+ "поставщик, договор или получение услуг.");
		Возврат;

	КонецЕсли;

	Если ВидДенежныхСредств =
		Перечисления.ВидыДенежныхСредств.Касса Тогда

		Если НЕ ЗначениеЗаполнено(Касса) Тогда

			ОшибкаВыплаты(Отказ, "Укажите кассу.");
			Возврат;

		КонецЕсли;

		Если НЕ КассаСоответствуетОрганизации(
			Касса, Организация) Тогда

			ОшибкаВыплаты(
				Отказ,
				"Касса не относится к организации "
				+ "или помечена на удаление.");
			Возврат;

		КонецЕсли;

		СчетДенег = ПланыСчетов.Хозрасчетный.Касса;
		АналитикаДенег = Касса;

	ИначеЕсли ВидДенежныхСредств =
		Перечисления.ВидыДенежныхСредств.БанковскийСчет Тогда

		ПроверитьБанковскийСчетДляСчета51(Отказ);

		Если Отказ Тогда
			Возврат;
		КонецЕсли;

		СчетДенег =
			ПланыСчетов.Хозрасчетный.РасчетныеСчета;
		АналитикаДенег = БанковскийСчет;

	Иначе

		ОшибкаВыплаты(
			Отказ,
			"Выберите кассу или расчётный банковский счёт.");
		Возврат;

	КонецЕсли;

	Долг = ФинансыСервер.ПолучитьДолгПоОплатеТруда(
		Организация, Сотрудник, Дата, Ссылка);

	Если Сумма > Долг Тогда

		ОшибкаВыплаты(
			Отказ,
			"Сумма выплаты превышает задолженность "
			+ "по оплате труда. Доступно: "
			+ Формат(Долг, "ЧДЦ=2") + ".");
		Возврат;

	КонецЕсли;

	Деньги = ФинансыСервер.ПолучитьДенежныйОстатокДляВыплаты(
		СчетДенег, Организация, АналитикаДенег, Дата, Ссылка);

	Если Сумма > Деньги Тогда

		ОшибкаВыплаты(
			Отказ,
			"Недостаточно денежных средств. Доступно: "
			+ Формат(Деньги, "ЧДЦ=2") + ".");
		Возврат;

	КонецЕсли;

	БылПроведен = Ложь;

	Если НЕ ЭтоНовый() Тогда
		БылПроведен = Ссылка.ПолучитьОбъект().Проведен;
	КонецЕсли;

	Если НЕ БылПроведен
		И ФинансыСервер.ЕстьПоздниеДвиженияПоОплатеТруда(
			Организация, Сотрудник, Дата, Ссылка) Тогда

		ОшибкаВыплаты(
			Отказ,
			"У сотрудника есть более поздние движения "
			+ "по счёту 70. Проведение задним числом запрещено.");

	КонецЕсли;

КонецПроцедуры


Процедура ЗаблокироватьДанныеВыплаты()

	Блокировки = Новый БлокировкаДанных;

	Счета = Новый Массив;
	Счета.Добавить(ПланыСчетов.Хозрасчетный.Касса);
	Счета.Добавить(ПланыСчетов.Хозрасчетный.РасчетныеСчета);
	Счета.Добавить(
		ПланыСчетов.Хозрасчетный.РасчетыПоОплатеТруда);

	Для Каждого Счет Из Счета Цикл

		Элемент = Блокировки.Добавить(
			"РегистрБухгалтерии.Хозрасчетный");
		Элемент.Режим =
			РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Счет", Счет);

	КонецЦикла;

	Блокировки.Заблокировать();

КонецПроцедуры


Процедура ОшибкаВыплаты(Отказ, ТекстСообщения)

	Отказ = Истина;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();

КонецПроцедуры


Процедура ПередЗаписью(
	Отказ,
	РежимЗаписи,
	РежимПроведения)

	Если Отказ Или ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;

	Старый = Ссылка.ПолучитьОбъект();

	Если НЕ Старый.Проведен Тогда
		Возврат;
	КонецЕсли;

	СтараяЗарплата = Старый.ВидОперации =
		Перечисления.ВидыОперацийСписанияДенежныхСредств.ВыплатаЗарплаты;

	Если НЕ СтараяЗарплата И НЕ ЭтоВыплатаЗарплаты() Тогда
		Возврат;
	КонецЕсли;

	Если РежимЗаписи =
		РежимЗаписиДокумента.ОтменаПроведения
		ИЛИ ВидОперации <> Старый.ВидОперации
		ИЛИ Дата <> Старый.Дата
		ИЛИ Организация <> Старый.Организация
		ИЛИ Сотрудник <> Старый.Сотрудник
		ИЛИ Сумма <> Старый.Сумма
		ИЛИ ВидДенежныхСредств <> Старый.ВидДенежныхСредств
		ИЛИ Касса <> Старый.Касса
		ИЛИ БанковскийСчет <> Старый.БанковскийСчет
		ИЛИ Контрагент <> Старый.Контрагент
		ИЛИ Договор <> Старый.Договор
		ИЛИ ПолучениеУслуг <> Старый.ПолучениеУслуг
		ИЛИ ПометкаУдаления <> Старый.ПометкаУдаления Тогда

		ОшибкаВыплаты(
			Отказ,
			"Изменение основных реквизитов или отмена "
			+ "проведения зарплатного списания запрещены. "
			+ "Проведённую старую операцию нельзя "
			+ "превратить в выплату зарплаты.");

	КонецЕсли;

КонецПроцедуры


Процедура ОбработкаУдаленияПроведения(Отказ)

	Если ЭтоВыплатаЗарплаты() Тогда

		ОшибкаВыплаты(
			Отказ,
			"Отмена проведения зарплатного списания запрещена.");

	КонецЕсли;

КонецПроцедуры