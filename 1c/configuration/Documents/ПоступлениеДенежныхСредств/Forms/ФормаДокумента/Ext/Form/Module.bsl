&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Дата = ТекущаяДата();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда

		ЕдинственнаяОрганизация =
			НСИСервер.ПолучитьЕдинственнуюОрганизацию();

		Если ЗначениеЗаполнено(ЕдинственнаяОрганизация) Тогда
			Объект.Организация = ЕдинственнаяОрганизация;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьВидимостьПолей();
	ОбновитьЗадолженностьНаСервере(Истина);

КонецПроцедуры


&НаКлиенте
Процедура ДатаПриИзменении(Элемент)

	ОбновитьЗадолженностьНаСервере(Истина);

КонецПроцедуры


&НаКлиенте
Процедура ВидДенежныхСредствПриИзменении(Элемент)

	ДенежныеСредстваКасса =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.Касса");

	ДенежныеСредстваБанк =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.БанковскийСчет");

	Если Объект.ВидДенежныхСредств = ДенежныеСредстваКасса Тогда

		Объект.БанковскийСчет =
			ПолучитьПустуюСсылкуБанковскогоСчета();

	ИначеЕсли Объект.ВидДенежныхСредств = ДенежныеСредстваБанк Тогда

		Объект.Касса =
			ПолучитьПустуюСсылкуКассы();

	Иначе

		Объект.Касса =
			ПолучитьПустуюСсылкуКассы();

		Объект.БанковскийСчет =
			ПолучитьПустуюСсылкуБанковскогоСчета();

	КонецЕсли;

	ОбновитьВидимостьПолей();

КонецПроцедуры


&НаКлиенте
Процедура ОбновитьВидимостьПолей()

	ДенежныеСредстваКасса =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.Касса");

	ДенежныеСредстваБанк =
		ПредопределенноеЗначение(
			"Перечисление.ВидыДенежныхСредств.БанковскийСчет");

	ЭтоКасса =
		Объект.ВидДенежныхСредств = ДенежныеСредстваКасса;

	ЭтоБанк =
		Объект.ВидДенежныхСредств = ДенежныеСредстваБанк;

	Элементы.Касса.Видимость = ЭтоКасса;
	Элементы.БанковскийСчет.Видимость = ЭтоБанк;

КонецПроцедуры


&НаСервере
Процедура ОбновитьЗадолженностьНаСервере(
	УстановитьСуммуПоУмолчанию = Ложь)

	ТекущаяЗадолженность =
		ФинансыСервер.ПолучитьДолгКлиента(
			Объект.Организация,
			Объект.Контрагент,
			Объект.Договор,
			Объект.Дата
		);

	Если УстановитьСуммуПоУмолчанию
		И Объект.Сумма = 0
		И ТекущаяЗадолженность > 0 Тогда

		Объект.Сумма = ТекущаяЗадолженность;

	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)

	ОбновитьЗадолженностьНаСервере(Истина);

КонецПроцедуры


&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	Объект.Договор = ПолучитьПустуюСсылкуДоговора();

	ТекущаяЗадолженность = 0;

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Сумма = 0;
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	Объект.Договор = ПолучитьПустуюСсылкуДоговора();
	Объект.Касса = ПолучитьПустуюСсылкуКассы();
	Объект.БанковскийСчет =
		ПолучитьПустуюСсылкуБанковскогоСчета();

	ТекущаяЗадолженность = 0;

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Сумма = 0;
	КонецЕсли;

КонецПроцедуры


&НаСервереБезКонтекста
Функция ПолучитьПустуюСсылкуДоговора()

	Возврат Справочники.Договоры.ПустаяСсылка();

КонецФункции


&НаСервереБезКонтекста
Функция ПолучитьПустуюСсылкуКассы()

	Возврат Справочники.Кассы.ПустаяСсылка();

КонецФункции


&НаСервереБезКонтекста
Функция ПолучитьПустуюСсылкуБанковскогоСчета()

	Возврат Справочники.БанковскиеСчета.ПустаяСсылка();

КонецФункции