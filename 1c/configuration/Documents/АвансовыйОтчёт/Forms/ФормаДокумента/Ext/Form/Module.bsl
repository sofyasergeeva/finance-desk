&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Дата = ТекущаяДата();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда

		ЕдинственнаяОрганизация =
			НСИСервер.ПолучитьЕдинственнуюОрганизацию();

		Если ЗначениеЗаполнено(ЕдинственнаяОрганизация) Тогда
			Объект.Организация = ЕдинственнаяОрганизация;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьОстатокПодотчетаНаСервере();

КонецПроцедуры


&НаКлиенте
Процедура ДатаПриИзменении(Элемент)

	ОбновитьОстатокПодотчетаНаСервере();

КонецПроцедуры


&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)

	ОбновитьОстатокПодотчетаНаСервере();

КонецПроцедуры


&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	ОбновитьОстатокПодотчетаНаСервере();

КонецПроцедуры


&НаСервере
Процедура ОбновитьОстатокПодотчетаНаСервере()

	ОстатокПодотчета =
		ФинансыСервер.ПолучитьОстатокПодотчета(
			Объект.Организация,
			Объект.Сотрудник,
			Объект.Дата
		);

КонецПроцедуры


&НаКлиенте
Процедура РасходыСуммаПриИзменении(Элемент)

	ПересчитатьСуммуДокумента();

КонецПроцедуры


&НаКлиенте
Процедура ПересчитатьСуммуДокумента()

	ИтогДокумента = 0;

	Для Каждого СтрокаРасхода Из Объект.Расходы Цикл

		ИтогДокумента =
			ИтогДокумента + СтрокаРасхода.Сумма;

	КонецЦикла;

	Объект.СуммаДокумента = ИтогДокумента;

КонецПроцедуры


&НаКлиенте
Процедура РасходыПослеУдаления(Элемент)

	ПересчитатьСуммуДокумента();

КонецПроцедуры

&НаКлиенте
Процедура ОформитьВозврат(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала запишите авансовый отчёт.");
		Возврат;
	КонецЕсли;

	Если НЕ Объект.Проведен Тогда
		Сообщить("Сначала проведите авансовый отчёт.");
		Возврат;
	КонецЕсли;

	Если ОстатокПодотчета <= 0 Тогда
		Сообщить("Остаток под отчётом отсутствует. Возврат оформлять не требуется.");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;

	ПараметрыФормы.Вставить(
		"ОрганизацияОснование",
		Объект.Организация);

	ПараметрыФормы.Вставить(
		"СотрудникОснование",
		Объект.Сотрудник);

	ОткрытьФорму(
		"Документ.ВозвратПодотчётныхСумм.Форма.ФормаДокумента",
		ПараметрыФормы,
		ЭтаФорма);

КонецПроцедуры