Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ПересчитатьСуммуРасходов();

КонецПроцедуры


Процедура ПересчитатьСуммуРасходов()

	ИтогРасходов = 0;

	Для Каждого СтрокаРасхода Из Расходы Цикл

		ИтогРасходов =
			ИтогРасходов + СтрокаРасхода.Сумма;

	КонецЦикла;

	СуммаДокумента = ИтогРасходов;

КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.Хозрасчетный.Записывать = Истина;

	Движение =
		Движения.Хозрасчетный.Добавить();

	Движение.Период = Дата;
	Движение.Сумма = СуммаДокумента;

	// Дт 26
	Движение.СчетДт =
		ПланыСчетов.Хозрасчетный.ОбщехозяйственныеРасходы;

	Движение.СубконтоДт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
	] = Организация;

	// Кт 71
	Движение.СчетКт =
		ПланыСчетов.Хозрасчетный.РасчетыСППодотчетнымиЛицами;

	Движение.СубконтоКт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Организации
	] = Организация;

	Движение.СубконтоКт[
		ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Сотрудники
	] = Сотрудник;

КонецПроцедуры


Процедура ОбработкаПроверкиЗаполнения(
	Отказ,
	ПроверяемыеРеквизиты)

	// Организация
	Если НЕ ЗначениеЗаполнено(Организация) Тогда

		Сообщение =
			Новый СообщениеПользователю;

		Сообщение.Текст =
			"Необходимо указать организацию.";

		Сообщение.Поле = "Организация";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// Сотрудник
	Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда

		Сообщение =
			Новый СообщениеПользователю;

		Сообщение.Текст =
			"Необходимо указать сотрудника.";

		Сообщение.Поле = "Сотрудник";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// Наличие расходов
	Если Расходы.Количество() = 0 Тогда

		Сообщение =
			Новый СообщениеПользователю;

		Сообщение.Текст =
			"Необходимо добавить хотя бы одну строку расходов.";

		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// Строки расходов
	ИтогРасходов = 0;

	Для Каждого СтрокаРасхода Из Расходы Цикл

		Если НЕ ЗначениеЗаполнено(
			СтрокаРасхода.ВидРасхода) Тогда

			Сообщение =
				Новый СообщениеПользователю;

			Сообщение.Текст =
				"В каждой строке расходов необходимо указать вид расхода.";

			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;


		Если СтрокаРасхода.Сумма <= 0 Тогда

			Сообщение =
				Новый СообщениеПользователю;

			Сообщение.Текст =
				"Сумма каждой строки расходов должна быть больше нуля.";

			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;

		ИтогРасходов =
			ИтогРасходов + СтрокаРасхода.Сумма;

	КонецЦикла;


	Если СуммаДокумента <= 0 Тогда

		Сообщение =
			Новый СообщениеПользователю;

		Сообщение.Текст =
			"Сумма документа должна быть больше нуля.";

		Сообщение.Поле = "СуммаДокумента";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	Если ИтогРасходов <> СуммаДокумента Тогда

		Сообщение =
			Новый СообщениеПользователю;

		Сообщение.Текст =
			"Сумма документа должна совпадать с общей суммой расходов.";

		Сообщение.Поле = "СуммаДокумента";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

		Отказ = Истина;

	КонецЕсли;


	// UX-06: контроль остатка 71
	Если ЗначениеЗаполнено(Организация)
		И ЗначениеЗаполнено(Сотрудник)
		И СуммаДокумента > 0 Тогда

		ДоступныйОстаток =
			ФинансыСервер.ПолучитьОстатокПодотчета(
				Организация,
				Сотрудник,
				Дата,
				Ссылка
			);

		Если ДоступныйОстаток <= 0 Тогда

			Сообщение =
				Новый СообщениеПользователю;

			Сообщение.Текст =
				"У сотрудника отсутствует доступный остаток под отчётом. Авансовый отчёт проводить не требуется.";

			Сообщение.Поле = "СуммаДокумента";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();

			Отказ = Истина;

		ИначеЕсли СуммаДокумента > ДоступныйОстаток Тогда

			Сообщение =
				Новый СообщениеПользователю;

			Сообщение.Текст =
				"Сумма авансового отчёта превышает доступный остаток под отчётом. Максимально допустимая сумма: "
				+ Формат(
					ДоступныйОстаток,
					"ЧДЦ=2")
				+ ".";

			Сообщение.Поле = "СуммаДокумента";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();

			Отказ = Истина;

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры


Процедура ОбработкаЗаполнения(
	ДанныеЗаполнения,
	СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) =
		Тип("ДокументСсылка.СписаниеДенежныхСредств") Тогда

		Организация =
			ДанныеЗаполнения.Организация;

		Сотрудник =
			ДанныеЗаполнения.Сотрудник;

		СписаниеДенежныхСредств =
			ДанныеЗаполнения.Ссылка;

		Дата = ТекущаяДата();

	КонецЕсли;

КонецПроцедуры