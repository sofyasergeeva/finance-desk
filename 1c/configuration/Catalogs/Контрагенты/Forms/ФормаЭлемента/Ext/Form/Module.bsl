&НаКлиенте
Процедура СоздатьДоговор(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала запишите контрагента.");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить(
		"КонтрагентОснование",
		Объект.Ссылка);

	ОткрытьФорму(
		"Справочник.Договоры.Форма.ФормаЭлемента",
		ПараметрыФормы,
		ЭтаФорма);

КонецПроцедуры