Процедура ПередЗаписью(Отказ)

	Если Отказ Или ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;

	СохраненныйСчет = Ссылка.ПолучитьОбъект();

	СтароеНазначение =
		НазначениеДляСравнения(
			СохраненныйСчет.НазначениеСчета);

	НовоеНазначение =
		НазначениеДляСравнения(НазначениеСчета);

	Если Организация = СохраненныйСчет.Организация
		И НовоеНазначение = СтароеНазначение Тогда

		Возврат;

	КонецЕсли;

	Если БанковскийСчетИспользуется() Тогда

		Отказ = Истина;

		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			"Нельзя изменить организацию или назначение "
			+ "банковского счёта: он используется "
			+ "в документах или бухгалтерских движениях. "
			+ "Для другого назначения создайте отдельный банковский счёт.";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();

	КонецЕсли;

КонецПроцедуры


Функция НазначениеДляСравнения(ЗначениеНазначения)

	Если НЕ ЗначениеЗаполнено(ЗначениеНазначения) Тогда

		Возврат
			Перечисления.НазначенияБанковскихСчетов.Расчетный;

	КонецЕсли;

	Возврат ЗначениеНазначения;

КонецФункции


Функция БанковскийСчетИспользуется()

	ИменаДокументов = Новый Массив;
	ИменаДокументов.Добавить(
		"ПоступлениеДенежныхСредств");
	ИменаДокументов.Добавить(
		"СписаниеДенежныхСредств");
	ИменаДокументов.Добавить(
		"ВозвратПодотчётныхСумм");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр(
		"БанковскийСчет", Ссылка);

	Для Каждого ИмяДокумента Из ИменаДокументов Цикл

		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Документы.Ссылка КАК Ссылка
			|ИЗ
			|	Документ." + ИмяДокумента + " КАК Документы
			|ГДЕ
			|	Документы.БанковскийСчет = &БанковскийСчет";

		Если НЕ Запрос.Выполнить().Пустой() Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Переводы.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПереводМеждуБанковскимиСчетами
		|		КАК Переводы
		|ГДЕ
		|	Переводы.БанковскийСчетСписания = &БанковскийСчет
		|	ИЛИ Переводы.БанковскийСчетЗачисления =
		|		&БанковскийСчет";

	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Возврат Истина;
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Движения.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто
		|		КАК Движения
		|ГДЕ
		|	Движения.СубконтоДт2 = &БанковскийСчет
		|	ИЛИ Движения.СубконтоКт2 = &БанковскийСчет";

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции