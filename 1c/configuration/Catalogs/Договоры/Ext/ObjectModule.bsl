Процедура ПередЗаписью(Отказ)

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЭтоНовый() Тогда

		СохраненныйДоговор = Ссылка.ПолучитьОбъект();

		Если Организация <> СохраненныйДоговор.Организация
			ИЛИ Контрагент <> СохраненныйДоговор.Контрагент Тогда

			Если ДоговорИспользуетсяВДокументах() Тогда

				Отказ = Истина;

				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст =
					"Нельзя изменить организацию или контрагента договора: "
					+ "договор используется в документах. "
					+ "Для других сторон создайте отдельный договор.";
				Сообщение.Сообщить();

				Возврат;

			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДатаДоговора) Тогда
		ДатаДоговора = ТекущаяДата();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = ДатаДоговора;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Наименование) Тогда

		Если ЗначениеЗаполнено(Номер) Тогда

			Наименование =
				"Договор №" + Номер
				+ " от "
				+ Формат(ДатаДоговора, "ДФ=dd.MM.yyyy");

		Иначе

			Наименование =
				"Договор от "
				+ Формат(ДатаДоговора, "ДФ=dd.MM.yyyy");

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры


Функция ДоговорИспользуетсяВДокументах()

	ИменаДокументов = Новый Массив;
	ИменаДокументов.Добавить("Сделка");
	ИменаДокументов.Добавить("АктОказанныхУслуг");
	ИменаДокументов.Добавить("ПолучениеУслуг");
	ИменаДокументов.Добавить("ПоступлениеДенежныхСредств");
	ИменаДокументов.Добавить("СписаниеДенежныхСредств");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договор", Ссылка);

	Для Каждого ИмяДокумента Из ИменаДокументов Цикл

		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Документ.Ссылка КАК Ссылка
			|ИЗ
			|	Документ." + ИмяДокумента + " КАК Документ
			|ГДЕ
			|	Документ.Договор = &Договор";

		Если НЕ Запрос.Выполнить().Пустой() Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции