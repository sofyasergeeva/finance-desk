&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда

		Если ЗначениеЗаполнено(Параметры.КонтрагентОснование) Тогда
			Объект.Контрагент = Параметры.КонтрагентОснование;
		КонецЕсли;

	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда

		Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда

			ЕдинственнаяОрганизация =
	НСИСервер.ПолучитьЕдинственнуюОрганизацию();

			Если ЗначениеЗаполнено(ЕдинственнаяОрганизация) Тогда
				Объект.Организация = ЕдинственнаяОрганизация;
			КонецЕсли;

		КонецЕсли;


		Если НЕ ЗначениеЗаполнено(Объект.ДатаДоговора) Тогда
			Объект.ДатаДоговора = ТекущаяДата();
		КонецЕсли;


		Если НЕ ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
			Объект.ДатаНачала = Объект.ДатаДоговора;
		КонецЕсли;


		Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда

			Объект.Наименование =
				"Договор от "
				+ Формат(
					Объект.ДатаДоговора,
					"ДФ=dd.MM.yyyy"
				);

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДатаДоговораПриИзменении(Элемент)

	ОбновитьНаименование();

КонецПроцедуры


&НаКлиенте
Процедура НомерПриИзменении(Элемент)

	ОбновитьНаименование();

КонецПроцедуры


&НаКлиенте
Процедура ОбновитьНаименование()

	Если НЕ ЗначениеЗаполнено(Объект.ДатаДоговора) Тогда

		Объект.Наименование = "Договор";
		Возврат;

	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Номер) Тогда

		Объект.Наименование =
			"Договор №" + Объект.Номер
			+ " от "
			+ Формат(Объект.ДатаДоговора, "ДФ=dd.MM.yyyy");

	Иначе

		Объект.Наименование =
			"Договор от "
			+ Формат(Объект.ДатаДоговора, "ДФ=dd.MM.yyyy");

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьСделку(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Сообщить("Сначала запишите договор.");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;

	ПараметрыФормы.Вставить(
		"ОрганизацияОснование",
		Объект.Организация);

	ПараметрыФормы.Вставить(
		"КонтрагентОснование",
		Объект.Контрагент);

	ПараметрыФормы.Вставить(
		"ДоговорОснование",
		Объект.Ссылка);

	ОткрытьФорму(
		"Документ.Сделка.Форма.ФормаДокумента",
		ПараметрыФормы,
		ЭтаФорма);

КонецПроцедуры

