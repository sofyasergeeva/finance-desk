&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьПоказателиНаСервере();

КонецПроцедуры


&НаСервере
Процедура ОбновитьПоказателиНаСервере()

	НамДолжны = 0;
	МыДолжны = 0;
	Банк = 0;
	Касса = 0;
	НезакрытыйПодотчет = 0;

	МоментРасчета = КонецДня(ТекущаяДата());


	// =====================================================
	// 1. ВЗАИМОРАСЧЁТЫ 60 / 62
	//
	// ВАЖНО:
	// считаем долг отдельно по аналитике,
	// чтобы переплата одного контрагента
	// не уменьшала долг другого.
	// =====================================================

	ЗапросДолги = Новый Запрос;

	ЗапросДолги.Текст =
	"ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Субконто1 КАК Организация,
	|	Остатки.Субконто2 КАК Контрагент,
	|	Остатки.Субконто3 КАК Договор,
	|	СУММА(Остатки.СуммаОстатокДт) КАК ОстатокДт,
	|	СУММА(Остатки.СуммаОстатокКт) КАК ОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|		&МоментРасчета
	|	) КАК Остатки
	|ГДЕ
	|	Остатки.Счет В (
	|		ЗНАЧЕНИЕ(
	|			ПланСчетов.Хозрасчетный.РасчетыСПокупателями
	|		),
	|		ЗНАЧЕНИЕ(
	|			ПланСчетов.Хозрасчетный.РасчетыСПоставщиками
	|		)
	|	)
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Счет,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3";

	ЗапросДолги.УстановитьПараметр(
		"МоментРасчета",
		МоментРасчета
	);

	ВыборкаДолги = ЗапросДолги.Выполнить().Выбрать();

	Пока ВыборкаДолги.Следующий() Цикл

		Если ВыборкаДолги.Счет =
			ПланыСчетов.Хозрасчетный.РасчетыСПокупателями Тогда

			ДолгКлиента =
				ВыборкаДолги.ОстатокДт
				- ВыборкаДолги.ОстатокКт;

			Если ДолгКлиента > 0 Тогда

				НамДолжны =
					НамДолжны
					+ ДолгКлиента;

			КонецЕсли;


		ИначеЕсли ВыборкаДолги.Счет =
			ПланыСчетов.Хозрасчетный.РасчетыСПоставщиками Тогда

			ДолгПоставщику =
				ВыборкаДолги.ОстатокКт
				- ВыборкаДолги.ОстатокДт;

			Если ДолгПоставщику > 0 Тогда

				МыДолжны =
					МыДолжны
					+ ДолгПоставщику;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;


	// =====================================================
	// 2. ДЕНЕЖНЫЕ СРЕДСТВА 50 / 51
	// =====================================================

	ЗапросДеньги = Новый Запрос;

	ЗапросДеньги.Текст =
	"ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	СУММА(Остатки.СуммаОстатокДт) КАК ОстатокДт,
	|	СУММА(Остатки.СуммаОстатокКт) КАК ОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|		&МоментРасчета
	|	) КАК Остатки
	|ГДЕ
	|	Остатки.Счет В (
	|		ЗНАЧЕНИЕ(
	|			ПланСчетов.Хозрасчетный.РасчетныеСчета
	|		),
	|		ЗНАЧЕНИЕ(
	|			ПланСчетов.Хозрасчетный.Касса
	|		)
	|	)
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Счет";

	ЗапросДеньги.УстановитьПараметр(
		"МоментРасчета",
		МоментРасчета
	);

	ВыборкаДеньги = ЗапросДеньги.Выполнить().Выбрать();

	Пока ВыборкаДеньги.Следующий() Цикл

		Если ВыборкаДеньги.Счет =
			ПланыСчетов.Хозрасчетный.РасчетныеСчета Тогда

			Банк =
				ВыборкаДеньги.ОстатокДт
				- ВыборкаДеньги.ОстатокКт;


		ИначеЕсли ВыборкаДеньги.Счет =
			ПланыСчетов.Хозрасчетный.Касса Тогда

			Касса =
				ВыборкаДеньги.ОстатокДт
				- ВыборкаДеньги.ОстатокКт;

		КонецЕсли;

	КонецЦикла;


	// =====================================================
	// 3. ПОДОТЧЁТ 71
	// =====================================================

	Запрос71 = Новый Запрос;

	Запрос71.Текст =
	"ВЫБРАТЬ
	|	Остатки.Субконто2 КАК Сотрудник,
	|	СУММА(Остатки.СуммаОстатокДт) КАК ОстатокДт,
	|	СУММА(Остатки.СуммаОстатокКт) КАК ОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|		&МоментРасчета
	|	) КАК Остатки
	|ГДЕ
	|	Остатки.Счет =
	|		ЗНАЧЕНИЕ(
	|			ПланСчетов.Хозрасчетный.РасчетыСППодотчетнымиЛицами
	|		)
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Субконто2";

	Запрос71.УстановитьПараметр(
		"МоментРасчета",
		МоментРасчета
	);

	Выборка71 = Запрос71.Выполнить().Выбрать();

	Пока Выборка71.Следующий() Цикл

		ОстатокСотрудника =
			Выборка71.ОстатокДт
			- Выборка71.ОстатокКт;

		Если ОстатокСотрудника > 0 Тогда

			НезакрытыйПодотчет =
				НезакрытыйПодотчет
				+ ОстатокСотрудника;

		КонецЕсли;

	КонецЦикла;


	// =====================================================
	// 4. БЛОК "ТРЕБУЕТ ВНИМАНИЯ"
	// =====================================================

	Если НамДолжны > 0 Тогда

		ТекстЗадолженностиКлиентов =
			Формат(
				НамДолжны,
				"ЧДЦ=2; ЧРГ=' '"
			);

	Иначе

		ТекстЗадолженностиКлиентов = "0,00";

	КонецЕсли;


	Если МыДолжны > 0 Тогда

		ТекстЗадолженностиПоставщикам =
			Формат(
				МыДолжны,
				"ЧДЦ=2; ЧРГ=' '"
			);

	Иначе

		ТекстЗадолженностиПоставщикам = "0,00";

	КонецЕсли;

КонецПроцедуры
&НаКлиенте
Процедура ОбновитьПоказатели(Команда)

	ОбновитьПоказателиНаСервере();

КонецПроцедуры


